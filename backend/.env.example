# Server Environment
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change_this_password

# development | production. Production requires IP_HASH_SALT and ADMIN_API_KEY
# to be set, and refuses to start without them.
ENVIRONMENT=development

# Security. Generate each with: openssl rand -hex 32
# Left blank in development, where an ephemeral per-process salt is generated.
IP_HASH_SALT=
ADMIN_API_KEY=
VOTE_RATE_LIMIT_PER_MINUTE=30

# Allows the x-dev-user-id header to stand in for a real login.
# Never enable outside local development.
ALLOW_DEV_AUTH_HEADERS=false

# Comma-separated origins allowed to call poll management and analytics endpoints
BACKEND_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

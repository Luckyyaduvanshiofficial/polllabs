---
import PollWidget from '../../../components/embed/PollWidget.svelte';
import '../../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { id: 'demo-frameworks' } },
    { params: { id: 'poll-state-manager' } },
    { params: { id: 'poll-backend-lang' } },
    { params: { id: 'poll-astro-deploy' } },
    { params: { id: 'sample-1' } },
    { params: { id: 'demo' } },
  ];
}

const { id } = Astro.params;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Poll Embed</title>
  </head>
  <body class="bg-transparent m-0 p-2 flex items-center justify-center min-h-screen">
    <PollWidget client:load pollId={id || ''} />
  </body>
</html>

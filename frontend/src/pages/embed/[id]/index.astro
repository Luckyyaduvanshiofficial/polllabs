---
/**
 * Pre-rendered iframe target for known ids: /embed/<poll-id>.
 * Ids created after the last build are served by /embed?id=<poll-id>.
 */
import PollWidget from '../../../components/embed/PollWidget.svelte';
import { DEMO_FRAMEWORKS_POLL } from '../../../lib/demo-poll';
import '../../../styles/global.css';

export function getStaticPaths() {
  return [
    { params: { id: 'demo-frameworks' } },
    { params: { id: 'poll-state-manager' } },
    { params: { id: 'poll-backend-lang' } },
    { params: { id: 'poll-astro-deploy' } },
    { params: { id: 'sample-1' } },
    { params: { id: 'demo' } },
  ];
}

const { id } = Astro.params;
const pollId = id ?? '';
const initialPoll = pollId === DEMO_FRAMEWORKS_POLL.id ? DEMO_FRAMEWORKS_POLL : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Poll</title>
    <style>
      html,
      body {
        background: transparent;
        min-height: 0;
        display: block;
        margin: 0;
        padding: 0.5rem;
      }
    </style>
  </head>
  <body>
    <PollWidget client:load pollId={pollId} initialPoll={initialPoll} />
  </body>
</html>

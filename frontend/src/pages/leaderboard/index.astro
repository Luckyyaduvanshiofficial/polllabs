---
import RootLayout from '../../layouts/RootLayout.astro';
---

<RootLayout title="Public Leaderboards — PollLabs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Trending & Top Polls</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">Discover what the developer community is voting on.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <div class="p-5 border border-gray-200 dark:border-gray-800 rounded-xl bg-white dark:bg-gray-800/50 shadow-xs hover:border-blue-500 transition">
        <div class="flex items-center justify-between text-xs text-gray-500 mb-2">
          <span>Trending #1</span>
          <span>1,248 votes</span>
        </div>
        <h3 class="font-semibold text-lg mb-4">
          <a href="/polls/sample-1" class="hover:text-blue-600">Which state manager do you use in React?</a>
        </h3>
        <div class="space-y-1 text-sm text-gray-600 dark:text-gray-300">
          <div class="flex justify-between"><span>Zustand</span><span class="font-semibold">58%</span></div>
          <div class="flex justify-between"><span>Redux Toolkit</span><span class="font-semibold">27%</span></div>
          <div class="flex justify-between"><span>Jotai</span><span class="font-semibold">15%</span></div>
        </div>
      </div>
    </div>
  </div>
</RootLayout>

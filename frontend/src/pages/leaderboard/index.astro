---
/**
 * Leaderboard. Three ranked tables sharing one tab strip, which keeps the page
 * a single dense surface instead of three stacked card sections.
 *
 * The most-voted-options table only contains polls whose owners publish raw
 * counts; the backend excludes masked polls, which is why totals here can be
 * lower than the trending table's.
 */
import RootLayout from '../../layouts/RootLayout.astro';

const tabs = [
  { id: 'trending', label: 'trending', note: 'Public polls with vote activity in the last 7 days.' },
  { id: 'top', label: 'all time', note: 'Public polls ranked by total votes.' },
  { id: 'options', label: 'top answers', note: 'Individual options ranked across polls that publish counts.' },
];
---

<RootLayout
  title="Leaderboard · Polls Lab"
  description="Trending and all-time public polls on Polls Lab, plus the most-voted answers across the platform."
>
  <section class="shell board">
    <header class="board__head">
      <h1 class="board__title">Leaderboard</h1>
      <p class="board__lede" data-tab-note>{tabs[0].note}</p>
    </header>

    <div class="tabs" role="tablist" aria-label="Leaderboard views">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="tab"
            data-tab={tab.id}
            data-note={tab.note}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="board__body">
      <div class="rows" data-loading>
        {
          [0, 1, 2, 3, 4, 5].map(() => (
            <div class="row">
              <div class="skeleton" style="height:0.8rem;width:1.5rem"></div>
              <div class="skeleton" style="height:0.9rem;width:42%"></div>
              <div class="skeleton" style="height:0.7rem;width:5rem;margin-left:auto"></div>
            </div>
          ))
        }
      </div>

      <div class="state state--error" data-error hidden>
        <p class="state__msg" data-error-text></p>
        <button type="button" class="btn btn--ghost" data-retry>Try again</button>
      </div>

      <div class="state" data-empty hidden>
        <p class="state__msg" data-empty-text>Nothing ranked yet.</p>
        <p class="state__hint">
          Rankings need public polls with votes. Create one and share the badge to get it moving.
        </p>
        <a href="/dashboard/create" class="btn btn--primary">Create a poll</a>
      </div>

      {
        tabs.map((tab, i) => (
          <div
            role="tabpanel"
            id={`panel-${tab.id}`}
            aria-labelledby={`tab-${tab.id}`}
            data-panel={tab.id}
            hidden={i !== 0}
          >
            <ol class="rank" data-rank={tab.id}></ol>
          </div>
        ))
      }
    </div>
  </section>
</RootLayout>

<style>
  .board {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .board__title {
    font-size: var(--text-3xl);
  }

  .board__lede {
    margin-top: var(--space-sm);
    font-size: var(--text-base);
    color: var(--color-ink-3);
    max-width: 58ch;
    min-height: 1.6rem;
    line-height: var(--leading-body);
  }

  .tabs {
    display: flex;
    gap: var(--space-lg);
    margin-block: var(--space-2xl) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .tab {
    appearance: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--color-ink-3);
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-sm) 0;
    min-height: 2.75rem;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .tab:hover {
    color: var(--color-ink);
  }

  .tab[aria-selected='true'] {
    color: var(--color-accent-strong);
    border-bottom-color: var(--color-accent);
  }

  .board__body {
    margin-top: var(--space-xl);
  }

  .rank {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .rank__item {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    gap: var(--space-lg);
    align-items: baseline;
    padding-block: var(--space-lg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .rank__n {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    color: var(--color-ink-4);
  }

  .rank__item:nth-child(-n + 3) .rank__n {
    color: var(--color-accent);
    font-weight: 600;
  }

  .rank__main {
    min-width: 0;
  }

  .rank__link {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    color: var(--color-ink);
  }

  a.rank__link:hover {
    color: var(--color-accent-strong);
  }

  .rank__sub {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-4);
  }

  .rank__sub a:hover {
    color: var(--color-accent-strong);
  }

  .rank__bar {
    margin-top: var(--space-sm);
    max-width: 24rem;
  }

  .rank__value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  .state {
    padding-block: var(--space-3xl);
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .state__msg {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink);
  }

  .state--error .state__msg {
    color: var(--color-danger);
  }

  .state__hint {
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    max-width: 52ch;
    line-height: var(--leading-body);
  }

  @media (max-width: 40rem) {
    .rank__item {
      grid-template-columns: 2rem 1fr;
      gap: var(--space-md);
    }

    .rank__value {
      grid-column: 2;
    }

    .tabs {
      overflow-x: auto;
      gap: var(--space-md);
    }
  }
</style>

<script>
  import {
    getTrending,
    getTop,
    getMostVotedOptions,
    type Poll,
    type MostVotedOption,
  } from '../../lib/api';

  type TabId = 'trending' | 'top' | 'options';

  let active: TabId = 'trending';
  const loaded = new Set<TabId>();
  let controller: AbortController | null = null;

  function el<T extends HTMLElement>(sel: string): T | null {
    return document.querySelector<T>(sel);
  }

  function setState(which: 'loading' | 'error' | 'empty' | 'data') {
    const loading = el<HTMLElement>('[data-loading]');
    const error = el<HTMLElement>('[data-error]');
    const empty = el<HTMLElement>('[data-empty]');
    if (loading) loading.hidden = which !== 'loading';
    if (error) error.hidden = which !== 'error';
    if (empty) empty.hidden = which !== 'empty';

    document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
      panel.hidden = which !== 'data' || panel.dataset.panel !== active;
    });
  }

  function pollRow(poll: Poll, index: number, max: number): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'rank__item';

    const n = document.createElement('span');
    n.className = 'rank__n';
    n.textContent = String(index + 1).padStart(2, '0');
    li.append(n);

    const main = document.createElement('div');
    main.className = 'rank__main';

    const link = document.createElement('a');
    link.className = 'rank__link';
    link.href = `/polls?id=${encodeURIComponent(poll.id)}`;
    link.textContent = poll.title;
    main.append(link);

    const sub = document.createElement('p');
    sub.className = 'rank__sub';
    const bits = [`${poll.options.length} options`];
    if (poll.max_selections > 1) bits.push('multi-select');
    if (poll.is_quiz) bits.push('quiz');
    sub.textContent = bits.join(' · ');
    main.append(sub);

    const votes = poll.total_votes ?? 0;
    if (max > 0 && typeof poll.total_votes === 'number') {
      const meter = document.createElement('div');
      meter.className = 'meter rank__bar';
      const fill = document.createElement('div');
      fill.className = index === 0 ? 'meter__fill meter__fill--lead' : 'meter__fill';
      fill.style.width = `${Math.max((votes / max) * 100, 2)}%`;
      meter.append(fill);
      main.append(meter);
    }

    li.append(main);

    const value = document.createElement('span');
    value.className = 'rank__value';
    value.textContent =
      typeof poll.total_votes === 'number' ? `${poll.total_votes} votes` : 'hidden';
    li.append(value);

    return li;
  }

  function optionRow(item: MostVotedOption, index: number, max: number): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'rank__item';

    const n = document.createElement('span');
    n.className = 'rank__n';
    n.textContent = String(index + 1).padStart(2, '0');
    li.append(n);

    const main = document.createElement('div');
    main.className = 'rank__main';

    const label = document.createElement('p');
    label.className = 'rank__link';
    label.textContent = item.option_text;
    main.append(label);

    const sub = document.createElement('p');
    sub.className = 'rank__sub';
    const link = document.createElement('a');
    link.href = `/polls?id=${encodeURIComponent(item.poll_id)}`;
    link.textContent = item.poll_title;
    link.style.textDecoration = 'underline';
    sub.append(document.createTextNode('in  '));
    sub.append(link);
    main.append(sub);

    if (max > 0) {
      const meter = document.createElement('div');
      meter.className = 'meter rank__bar';
      const fill = document.createElement('div');
      fill.className = index === 0 ? 'meter__fill meter__fill--lead' : 'meter__fill';
      fill.style.width = `${Math.max((item.vote_count / max) * 100, 2)}%`;
      meter.append(fill);
      main.append(meter);
    }

    li.append(main);

    const value = document.createElement('span');
    value.className = 'rank__value';
    value.textContent = `${item.vote_count} votes`;
    li.append(value);

    return li;
  }

  async function load(tab: TabId, force = false) {
    if (loaded.has(tab) && !force) {
      setState('data');
      return;
    }

    controller?.abort();
    controller = new AbortController();
    setState('loading');

    const signal = controller.signal;
    const result =
      tab === 'trending'
        ? await getTrending(20, signal)
        : tab === 'top'
          ? await getTop(20, signal)
          : await getMostVotedOptions(20, signal);

    if (!result.ok) {
      if (signal.aborted) return;
      const text = el<HTMLElement>('[data-error-text]');
      if (text) text.textContent = result.error;
      setState('error');
      return;
    }

    const list = el<HTMLOListElement>(`[data-rank="${tab}"]`);
    if (!list) return;
    list.replaceChildren();

    if (tab === 'options') {
      const items = (result.data as { items: MostVotedOption[] }).items;
      if (items.length === 0) {
        const msg = el<HTMLElement>('[data-empty-text]');
        if (msg) msg.textContent = 'No polls currently publish per-option counts.';
        setState('empty');
        return;
      }
      const max = Math.max(...items.map((i) => i.vote_count));
      items.forEach((item, i) => list.append(optionRow(item, i, max)));
    } else {
      const polls = (result.data as { leaderboard: Poll[] }).leaderboard;
      if (polls.length === 0) {
        const msg = el<HTMLElement>('[data-empty-text]');
        if (msg) {
          msg.textContent =
            tab === 'trending' ? 'No polls have seen votes this week.' : 'No ranked polls yet.';
        }
        setState('empty');
        return;
      }
      const max = Math.max(...polls.map((p) => p.total_votes ?? 0));
      polls.forEach((poll, i) => list.append(pollRow(poll, i, max)));
    }

    loaded.add(tab);
    setState('data');
  }

  function selectTab(tab: TabId) {
    active = tab;

    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((btn) => {
      const on = btn.dataset.tab === tab;
      btn.setAttribute('aria-selected', String(on));
      btn.tabIndex = on ? 0 : -1;
      if (on) {
        const note = el<HTMLElement>('[data-tab-note]');
        if (note) note.textContent = btn.dataset.note ?? '';
      }
    });

    load(tab);
  }

  function init() {
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));

    buttons.forEach((btn, index) => {
      btn.onclick = () => selectTab(btn.dataset.tab as TabId);

      // Arrow-key tab navigation, per WAI-ARIA tabs pattern.
      btn.onkeydown = (event) => {
        const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        const next = buttons[(index + delta + buttons.length) % buttons.length];
        next.focus();
        selectTab(next.dataset.tab as TabId);
      };
    });

    const retry = el<HTMLButtonElement>('[data-retry]');
    if (retry) retry.onclick = () => load(active, true);

    loaded.clear();
    selectTab('trending');
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

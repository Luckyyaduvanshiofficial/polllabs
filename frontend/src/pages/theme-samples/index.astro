---
/**
 * Poll theme reference. Renders the same poll under each of the five
 * appearance themes the API actually supports, so a creator can see what
 * `appearance.theme` does before choosing one.
 *
 * This replaces an earlier scratch sampler that previewed site design
 * directions rather than product themes.
 */
import RootLayout from '../../layouts/RootLayout.astro';
import PollWidget from '../../components/embed/PollWidget.svelte';
import type { DemoPoll } from '../../lib/demo-poll';

const basePoll: DemoPoll = {
  id: 'theme-preview',
  title: 'Which embed fits your README?',
  description: 'A preview poll. Voting is disabled on this page.',
  visibility: 'public',
  result_display: 'show_counts',
  owner: 'polls-lab',
  total_votes: 255,
  options: [
    { id: 'o1', text: 'SVG badge', vote_count: 128, percentage: 50.2 },
    { id: 'o2', text: 'Interactive iframe', vote_count: 86, percentage: 33.7 },
    { id: 'o3', text: 'PNG badge', vote_count: 41, percentage: 16.1 },
  ],
};

const themes = [
  {
    id: 'minimal',
    name: 'minimal',
    note: 'The default. Neutral surface, single accent, list layout.',
    layout: 'list',
  },
  {
    id: 'whatsapp',
    name: 'whatsapp',
    note: 'Chat-bubble surface with a green accent, for messaging contexts.',
    layout: 'list',
  },
  {
    id: 'telegram',
    name: 'telegram',
    note: 'Light card with a blue accent and tighter rows.',
    layout: 'list',
  },
  {
    id: 'story',
    name: 'story',
    note: 'Sticker-style card sized for vertical screenshots.',
    layout: 'list',
  },
  {
    id: 'youtube-grid',
    name: 'youtube-grid',
    note: 'Tiled layout for options that carry images.',
    layout: 'grid',
  },
] as const;
---

<RootLayout
  title="Poll themes · Polls Lab"
  description="The five built-in poll appearance themes, each rendered with the same poll so you can compare them."
>
  <section class="shell themes">
    <header class="themes__head">
      <h1 class="themes__title">Poll themes</h1>
      <p class="themes__lede">
        Every poll carries its own appearance. Pick a preset in the creator, then override the
        background, accent, ink, corners, font and layout individually. The same poll is rendered
        below under each preset.
      </p>
      <p class="themes__note">
        Set these under <code>appearance.theme</code> when creating a poll through the API, or with
        the theme picker in the creator.
      </p>
    </header>

    <div class="themes__list">
      {
        themes.map((theme) => (
          <article class="sample" aria-labelledby={`theme-${theme.id}`}>
            <header class="sample__head">
              <h2 id={`theme-${theme.id}`} class="sample__name">
                <code>{theme.id}</code>
              </h2>
              <p class="sample__note">{theme.note}</p>
              <p class="sample__meta">layout: {theme.layout}</p>
            </header>

            <div class="sample__frame">
              <PollWidget
                client:visible
                pollId=""
                initialPoll={{
                  ...basePoll,
                  id: `${basePoll.id}-${theme.id}`,
                  appearance: {
                    theme: theme.id,
                    layout: theme.layout,
                    radius: 'rounded',
                    font: 'system',
                    effect: 'none',
                  },
                }}
              />
            </div>
          </article>
        ))
      }
    </div>

    <footer class="themes__foot rule-top">
      <p class="themes__foot-text">
        Ready to pick one? The creator shows a live preview as you change the theme and colours.
      </p>
      <a href="/dashboard/create" class="btn btn--primary">Create a poll</a>
    </footer>
  </section>
</RootLayout>

<style>
  .themes {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .themes__title {
    font-size: var(--text-2xl);
  }

  .themes__lede {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: 68ch;
    line-height: 1.7;
  }

  .themes__note {
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
  }

  .themes__note code,
  .sample__name code {
    color: var(--color-accent);
  }

  .themes__list {
    margin-top: var(--space-2xl);
    display: grid;
    gap: var(--space-2xl);
  }

  .sample {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .sample__name {
    font-size: var(--text-base);
  }

  .sample__note {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    line-height: 1.7;
  }

  .sample__meta {
    margin-top: var(--space-xs);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-4);
  }

  /* A neutral mid surface so light and dark themes both read honestly. */
  .sample__frame {
    min-width: 0;
    padding: var(--space-md);
    background: var(--color-paper-3);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
  }

  .themes__foot {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .themes__foot-text {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  @media (max-width: 60rem) {
    .sample {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-md);
    }
  }
</style>

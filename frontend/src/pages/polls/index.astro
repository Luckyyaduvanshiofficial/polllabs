---
import RootLayout from '../../layouts/RootLayout.astro';
---

<RootLayout title="View Poll — Polls Lab">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <!-- Breadcrumbs -->
    <div class="flex items-center justify-between text-xs text-[#94a3b8] pb-4 border-b border-[#1e293b]">
      <a href="/leaderboard" class="hover:text-white transition flex items-center gap-1">
        <span>← Back to Leaderboards</span>
      </a>
      <span class="font-mono text-[#64748b]" id="poll-id-display">Loading...</span>
    </div>

    <!-- Center: Interactive Voting Widget (Strict Multi-Framework Isolation) -->
    <div class="max-w-md mx-auto">
      <div class="bg-[#111827] border border-[#1e293b] rounded-2xl p-2 shadow-xl overflow-hidden min-h-[360px] flex items-center justify-center">
        <iframe
          id="poll-iframe"
          src="/embed?id=demo-frameworks"
          title="Interactive Poll"
          class="w-full h-[360px] border-0 rounded-xl"
          loading="lazy"
        ></iframe>
      </div>
    </div>

    <!-- Bottom Actions: Embed Snippets & Sharing -->
    <div class="max-w-md mx-auto p-6 rounded-2xl bg-[#111827] border border-[#1e293b] space-y-4 shadow-xl text-xs">
      <h3 class="font-semibold text-white text-sm">Embed This Poll in Your Content</h3>
      <p class="text-[#94a3b8]">
        Drop this poll into your GitHub repository or documentation site:
      </p>

      <div class="space-y-3">
        <div>
          <label class="block font-medium text-[#94a3b8] mb-1">GitHub README (SVG Badge)</label>
          <div class="flex gap-2">
            <input
              id="poll-badge-input"
              readOnly
              value="Loading..."
              class="flex-1 px-2.5 py-1.5 bg-[#0b0f19] border border-[#1e293b] rounded-lg font-mono text-[11px] text-emerald-300"
            />
            <button
              id="copy-badge-btn"
              type="button"
              class="px-3 py-1.5 rounded-lg bg-[#1e293b] hover:bg-[#334155] text-white font-medium transition"
            >
              Copy
            </button>
          </div>
        </div>

        <div>
          <label class="block font-medium text-[#94a3b8] mb-1">Interactive Iframe (HTML)</label>
          <div class="flex gap-2">
            <input
              id="poll-iframe-input"
              readOnly
              value="Loading..."
              class="flex-1 px-2.5 py-1.5 bg-[#0b0f19] border border-[#1e293b] rounded-lg font-mono text-[11px] text-cyan-300"
            />
            <button
              id="copy-iframe-btn"
              type="button"
              class="px-3 py-1.5 rounded-lg bg-[#1e293b] hover:bg-[#334155] text-white font-medium transition"
            >
              Copy
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</RootLayout>

<script>
  import { getMarkdownBadgeSnippet, getIframeSnippet } from '../../lib/embed';

  function initDynamicPoll() {
    const params = new URLSearchParams(window.location.search);
    const pollId = params.get('id') || 'demo-frameworks';

    const idDisplay = document.getElementById('poll-id-display');
    const iframe = document.getElementById('poll-iframe') as HTMLIFrameElement | null;
    const badgeInput = document.getElementById('poll-badge-input') as HTMLInputElement | null;
    const iframeInput = document.getElementById('poll-iframe-input') as HTMLInputElement | null;

    if (idDisplay) idDisplay.textContent = `ID: ${pollId}`;
    if (iframe) iframe.src = `/embed?id=${encodeURIComponent(pollId)}`;
    if (badgeInput) badgeInput.value = getMarkdownBadgeSnippet('Poll', pollId);
    if (iframeInput) iframeInput.value = getIframeSnippet(pollId);

    const copyBadgeBtn = document.getElementById('copy-badge-btn');
    const copyIframeBtn = document.getElementById('copy-iframe-btn');

    copyBadgeBtn?.addEventListener('click', () => {
      if (badgeInput) {
        navigator.clipboard.writeText(badgeInput.value).then(() => {
          copyBadgeBtn.textContent = '✓ Copied';
          setTimeout(() => { copyBadgeBtn.textContent = 'Copy'; }, 2000);
        });
      }
    });

    copyIframeBtn?.addEventListener('click', () => {
      if (iframeInput) {
        navigator.clipboard.writeText(iframeInput.value).then(() => {
          copyIframeBtn.textContent = '✓ Copied';
          setTimeout(() => { copyIframeBtn.textContent = 'Copy'; }, 2000);
        });
      }
    });
  }

  initDynamicPoll();
  document.addEventListener('astro:page-load', initDynamicPoll);
</script>

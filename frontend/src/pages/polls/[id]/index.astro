---
/**
 * Standalone poll page, pre-rendered for known ids. This is the link a badge
 * points at, so it carries the share chrome that /embed deliberately omits.
 *
 * Ids created after the last build are served by /polls?id=<id> instead.
 */
import RootLayout from '../../../layouts/RootLayout.astro';
import PollWidget from '../../../components/embed/PollWidget.svelte';
import { DEMO_FRAMEWORKS_POLL } from '../../../lib/demo-poll';

export function getStaticPaths() {
  return [
    { params: { id: 'demo-frameworks' } },
    { params: { id: 'poll-state-manager' } },
    { params: { id: 'poll-backend-lang' } },
    { params: { id: 'poll-astro-deploy' } },
    { params: { id: 'sample-1' } },
    { params: { id: 'demo' } },
  ];
}

const { id } = Astro.params;
const pollId = id ?? '';
const initialPoll = pollId === DEMO_FRAMEWORKS_POLL.id ? DEMO_FRAMEWORKS_POLL : null;
---

<RootLayout
  title={`Poll ${pollId} · Polls Lab`}
  description="Vote on this poll. Anonymous, one vote per device, no account required."
>
  <section class="shell page">
    <div class="page__grid">
      <div class="page__main">
        <PollWidget client:load pollId={pollId} initialPoll={initialPoll} />
      </div>

      <aside class="page__side" aria-labelledby="embed-title">
        <h2 id="embed-title" class="page__side-title">Embed this poll</h2>

        <div class="snip">
          <p class="field-label">Markdown badge</p>
          <div class="code">
            <pre data-snippet={`[![Poll](API/api/v1/badges/${pollId}.svg)](SITE/polls/${pollId})`}><code
            ></code></pre>
          </div>
          <button type="button" class="btn btn--quiet" data-copy>copy</button>
        </div>

        <div class="snip">
          <p class="field-label">Iframe</p>
          <div class="code">
            <pre
              data-snippet={`<iframe src="SITE/embed?id=${pollId}" width="100%" height="380" style="border:0" loading="lazy"></iframe>`}><code
            ></code></pre>
          </div>
          <button type="button" class="btn btn--quiet" data-copy>copy</button>
        </div>

        <p class="page__note">
          The badge is a live image: it re-renders on every load, so a README shows current results
          without a rebuild.
        </p>
      </aside>
    </div>
  </section>
</RootLayout>

<style>
  .page {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .page__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .page__main {
    min-width: 0;
  }

  .page__side {
    min-width: 0;
    display: grid;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
  }

  .page__side-title {
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  .snip {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    min-width: 0;
    width: 100%;
  }

  .snip .code {
    width: 100%;
    background: var(--color-paper);
  }

  .snip pre {
    white-space: pre-wrap;
    word-break: break-all;
  }

  .page__note {
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    line-height: var(--leading-body);
  }

  @media (max-width: 60rem) {
    .page__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>

<script>
  import { getApiUrl, getSiteUrl } from '../../../lib/config';

  function resolve() {
    const api = getApiUrl();
    const site = getSiteUrl();
    document.querySelectorAll<HTMLElement>('pre[data-snippet]').forEach((pre) => {
      const resolved = (pre.dataset.snippet ?? '').replaceAll('API', api).replaceAll('SITE', site);
      pre.dataset.resolved = resolved;
      const code = pre.querySelector('code');
      if (code) code.textContent = resolved;
    });
  }

  function wireCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.onclick = async () => {
        const pre = btn.parentElement?.querySelector<HTMLElement>('pre[data-snippet]');
        const text = pre?.dataset.resolved ?? '';
        if (!text) return;
        const label = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'copied';
        } catch {
          btn.textContent = 'copy failed';
        }
        window.setTimeout(() => {
          btn.textContent = label;
        }, 1600);
      };
    });
  }

  function init() {
    resolve();
    wireCopy();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

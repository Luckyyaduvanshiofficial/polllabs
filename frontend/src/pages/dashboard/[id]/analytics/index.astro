---
/**
 * Pre-rendered analytics page for known poll ids. Kept so existing links and
 * bookmarks keep resolving; /dashboard/analytics?id=<id> handles every other id.
 */
import RootLayout from '../../../../layouts/RootLayout.astro';
import PollAnalytics from '../../../../components/dashboard/PollAnalytics';

export function getStaticPaths() {
  return [
    { params: { id: 'demo-frameworks' } },
    { params: { id: 'poll-state-manager' } },
    { params: { id: 'poll-backend-lang' } },
    { params: { id: 'poll-astro-deploy' } },
    { params: { id: 'poll-private-team-sync' } },
  ];
}

const { id } = Astro.params;
---

<RootLayout title="Poll analytics · Polls Lab" noindex>
  <section class="shell an-page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/dashboard">dashboard</a>
      <span aria-hidden="true">/</span>
      <span class="crumbs__here">analytics</span>
    </nav>

    <PollAnalytics client:load pollId={id ?? ''} />
  </section>
</RootLayout>

<style>
  .an-page {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-ink-4);
    margin-bottom: var(--space-xl);
  }

  .crumbs a {
    color: var(--color-ink-3);
    min-height: 1.75rem;
    display: inline-flex;
    align-items: center;
  }

  .crumbs a:hover {
    color: var(--color-accent-strong);
  }

  .crumbs__here {
    color: var(--color-ink-2);
  }
</style>

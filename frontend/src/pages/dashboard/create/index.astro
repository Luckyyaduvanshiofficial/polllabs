---
import RootLayout from '../../../layouts/RootLayout.astro';
import PollCreator from '../../../components/dashboard/PollCreator';
---

<RootLayout title="Create a Poll — Polls Lab Studio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb & Nav -->
    <div class="mb-8 flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs text-[#94a3b8]">
        <a href="/dashboard" class="hover:text-white transition flex items-center gap-1">
          <span>← Back to Dashboard</span>
        </a>
        <span>/</span>
        <span class="text-white font-medium">New Poll Studio</span>
      </div>
      <span class="text-xs font-mono text-[#64748b]">v1.0 API</span>
    </div>

    <PollCreator client:load />
  </div>
</RootLayout>


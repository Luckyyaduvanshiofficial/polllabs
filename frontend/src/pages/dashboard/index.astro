---
/**
 * Owner dashboard.
 *
 * Constraint worth knowing: the API's only list endpoint is GET /polls, which
 * filters to visibility="public". There is no "polls I own" endpoint, so this
 * page lists public polls and keeps the ones owned by the signed-in user.
 * Private polls cannot be listed until the backend grows an owner-scoped
 * endpoint; the page says so rather than pretending the list is complete.
 */
import RootLayout from '../../layouts/RootLayout.astro';
---

<RootLayout title="Dashboard · Polls Lab" noindex>
  <section class="shell dash">
    <header class="dash__head">
      <div>
        <h1 class="dash__title">Dashboard</h1>
        <p class="dash__lede" data-owner-line>Your polls, newest first.</p>
      </div>
      <a href="/dashboard/create" class="btn btn--primary">New poll</a>
    </header>

    <!-- Unauthenticated -->
    <div class="state" data-signedout hidden>
      <p class="state__msg">Sign in to manage your polls.</p>
      <p class="state__hint">
        Polls Lab uses GitHub via PocketBase. Voting never needs an account; creating and editing
        does.
      </p>
      <button type="button" class="btn btn--primary" data-signin-cta>Sign in with GitHub</button>
      <p class="state__err" data-signin-error hidden></p>
    </div>

    <div data-authed hidden>
      <!-- Pending deletion notice, read from /auth/me. -->
      <div class="notice" data-deletion hidden>
        <p class="notice__title">This account is scheduled for deletion</p>
        <p class="notice__body">
          Everything you own is removed when the grace period ends
          <span data-deletion-when></span>. You can stop this at any time before then.
        </p>
        <button type="button" class="btn btn--ghost" data-cancel-deletion>Keep my account</button>
      </div>

      <!-- Loading -->
      <div class="rows" data-loading>
        {
          [0, 1, 2].map(() => (
            <div class="row">
              <div class="skeleton" style="height:0.9rem;width:34%"></div>
              <div class="skeleton" style="height:0.7rem;width:6rem;margin-left:auto"></div>
            </div>
          ))
        }
      </div>

      <!-- Error -->
      <div class="state state--error" data-error hidden>
        <p class="state__msg" data-error-text></p>
        <button type="button" class="btn btn--ghost" data-retry>Try again</button>
      </div>

      <!-- Empty -->
      <div class="state" data-empty hidden>
        <p class="state__msg">No public polls under your account yet.</p>
        <p class="state__hint">
          Create one and you can embed it in a README the same minute. Private polls do not appear in
          this list; the API has no owner-scoped listing yet.
        </p>
        <a href="/dashboard/create" class="btn btn--primary">Create your first poll</a>
      </div>

      <!-- List -->
      <ul class="owned" data-results hidden></ul>

      <p class="dash__footnote" data-footnote hidden>
        Only public polls appear here. Private polls exist and keep working, but the API cannot list
        them yet.
      </p>

      <!-- Account -->
      <section class="danger rule-top" aria-labelledby="account-title">
        <h2 id="account-title" class="danger__title">Account</h2>
        <p class="danger__body">
          Deleting your account starts a 7 day grace period. When it ends, the account and every poll
          and vote it owns are removed permanently.
        </p>
        <button type="button" class="btn btn--danger" data-delete-account>
          Request account deletion
        </button>
        <p class="danger__result" data-account-msg hidden></p>
      </section>
    </div>
  </section>

  <!-- Embed dialog -->
  <dialog class="modal" data-embed-dialog aria-labelledby="embed-dialog-title">
    <div class="modal__inner">
      <div class="modal__head">
        <h2 id="embed-dialog-title" class="modal__title">Embed this poll</h2>
        <button type="button" class="btn btn--quiet" data-close-embed aria-label="Close">close</button>
      </div>
      <div class="modal__body">
        <div class="snip">
          <p class="field-label">Markdown badge</p>
          <div class="code"><pre data-embed-badge><code></code></pre></div>
          <button type="button" class="btn btn--quiet" data-copy-badge>copy</button>
        </div>
        <div class="snip">
          <p class="field-label">Iframe</p>
          <div class="code"><pre data-embed-iframe><code></code></pre></div>
          <button type="button" class="btn btn--quiet" data-copy-iframe>copy</button>
        </div>
      </div>
    </div>
  </dialog>

  <!-- Edit dialog -->
  <dialog class="modal" data-edit-dialog aria-labelledby="edit-dialog-title">
    <form class="modal__inner" data-edit-form>
      <div class="modal__head">
        <h2 id="edit-dialog-title" class="modal__title">Edit poll</h2>
        <button type="button" class="btn btn--quiet" data-close-edit aria-label="Close">close</button>
      </div>
      <div class="modal__body">
        <input type="hidden" data-edit-id />
        <div class="fieldrow">
          <label class="field-label" for="edit-title">Title</label>
          <input id="edit-title" class="input" type="text" required minlength="3" maxlength="200" data-edit-title />
        </div>
        <div class="fieldrow">
          <label class="field-label" for="edit-desc">Description</label>
          <textarea id="edit-desc" class="input" rows="3" maxlength="1000" data-edit-desc></textarea>
        </div>
        <p class="modal__err" data-edit-error hidden></p>
      </div>
      <div class="modal__foot">
        <button type="button" class="btn btn--ghost" data-cancel-edit>Cancel</button>
        <button type="submit" class="btn btn--primary" data-save-edit>Save changes</button>
      </div>
    </form>
  </dialog>

  <!-- Delete confirm -->
  <dialog class="modal" data-del-dialog aria-labelledby="del-dialog-title">
    <div class="modal__inner">
      <div class="modal__head">
        <h2 id="del-dialog-title" class="modal__title">Delete poll</h2>
        <button type="button" class="btn btn--quiet" data-close-del aria-label="Close">close</button>
      </div>
      <div class="modal__body">
        <p class="modal__text">
          <span data-del-title></span> and all of its votes are removed permanently. Any badge or
          embed pointing at it stops working.
        </p>
        <p class="modal__err" data-del-error hidden></p>
      </div>
      <div class="modal__foot">
        <button type="button" class="btn btn--ghost" data-cancel-del>Keep it</button>
        <button type="button" class="btn btn--danger" data-confirm-del>Delete permanently</button>
      </div>
    </div>
  </dialog>
</RootLayout>

<style>
  .dash {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .dash__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-xl);
  }

  .dash__title {
    font-size: var(--text-2xl);
  }

  .dash__lede {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }

  .dash__footnote {
    margin-top: var(--space-md);
    font-size: var(--text-2xs);
    color: var(--color-ink-4);
    max-width: 64ch;
    line-height: 1.7;
  }

  .owned {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .owned__item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-xs) var(--space-md);
    padding-block: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .owned__title {
    font-size: var(--text-base);
    color: var(--color-ink);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .owned__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-2xs);
    color: var(--color-ink-4);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .owned__votes {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .owned__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .notice {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    padding: var(--space-md);
    margin-bottom: var(--space-lg);
    background: var(--color-warn-wash);
    border-left: 2px solid var(--color-warn);
  }

  .notice__title {
    font-size: var(--text-sm);
    color: var(--color-ink);
    font-weight: 600;
  }

  .notice__body {
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    line-height: 1.7;
  }

  .state {
    padding-block: var(--space-2xl);
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .state__msg {
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  .state--error .state__msg {
    color: var(--color-danger);
  }

  .state__hint {
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    max-width: 58ch;
    line-height: 1.7;
  }

  .state__err {
    font-size: var(--text-xs);
    color: var(--color-danger);
  }

  .danger {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  .danger__title {
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .danger__body {
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    max-width: 58ch;
    line-height: 1.7;
  }

  .danger__result {
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  /* ---- Modals ---- */
  .modal {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(38rem, calc(100vw - 2rem));
    width: 100%;
  }

  .modal::backdrop {
    background: oklch(8% 0.01 200 / 0.72);
    backdrop-filter: blur(2px);
  }

  .modal__inner {
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule-strong);
    border-radius: var(--radius-md);
    display: grid;
  }

  .modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .modal__title {
    font-size: var(--text-sm);
  }

  .modal__body {
    padding: var(--space-md);
    display: grid;
    gap: var(--space-lg);
  }

  .modal__text {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.7;
  }

  .modal__foot {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .modal__err {
    font-size: var(--text-xs);
    color: var(--color-danger);
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-danger-wash);
    border-left: 2px solid var(--color-danger);
  }

  .fieldrow {
    display: grid;
    gap: var(--space-2xs);
  }

  .snip {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .snip .code {
    width: 100%;
  }

  .snip pre {
    white-space: pre-wrap;
    word-break: break-all;
  }

  @media (max-width: 40rem) {
    .dash__head {
      align-items: stretch;
    }
  }
</style>

<script>
  import {
    listPolls,
    deletePoll,
    updatePoll,
    getCurrentUser,
    requestAccountDeletion,
    cancelAccountDeletion,
    type Poll,
  } from '../../lib/api';
  import { isSignedIn, readUserId, startSignIn } from '../../lib/auth';
  import { getMarkdownBadgeSnippet, getIframeSnippet } from '../../lib/embed';

  let owned: Poll[] = [];
  let pendingDeleteId: string | null = null;

  function el<T extends HTMLElement>(sel: string): T | null {
    return document.querySelector<T>(sel);
  }

  function show(which: 'loading' | 'error' | 'empty' | 'results') {
    const map = {
      loading: '[data-loading]',
      error: '[data-error]',
      empty: '[data-empty]',
      results: '[data-results]',
    } as const;
    for (const [key, sel] of Object.entries(map)) {
      const node = el<HTMLElement>(sel);
      if (node) node.hidden = key !== which;
    }
    const note = el<HTMLElement>('[data-footnote]');
    if (note) note.hidden = which !== 'results';
  }

  function renderOwned() {
    const list = el<HTMLUListElement>('[data-results]');
    if (!list) return;
    list.replaceChildren();

    for (const poll of owned) {
      const li = document.createElement('li');
      li.className = 'owned__item';

      const title = document.createElement('a');
      title.className = 'owned__title';
      title.href = `/polls?id=${encodeURIComponent(poll.id)}`;
      title.textContent = poll.title;
      li.append(title);

      const votes = document.createElement('span');
      votes.className = 'owned__votes';
      votes.textContent = `${poll.total_votes ?? 0} votes`;
      li.append(votes);

      const meta = document.createElement('p');
      meta.className = 'owned__meta';
      const closed = poll.close_at && new Date(poll.close_at).getTime() <= Date.now();
      meta.textContent = [
        poll.visibility,
        `${poll.options.length} options`,
        poll.result_display.replace(/_/g, ' '),
        closed ? 'closed' : null,
      ]
        .filter(Boolean)
        .join('   /   ');
      li.append(meta);

      const actions = document.createElement('div');
      actions.className = 'owned__actions';

      const analytics = document.createElement('a');
      analytics.className = 'btn btn--quiet';
      analytics.href = `/dashboard/${encodeURIComponent(poll.id)}/analytics`;
      analytics.textContent = 'analytics';
      actions.append(analytics);

      const embed = document.createElement('button');
      embed.type = 'button';
      embed.className = 'btn btn--quiet';
      embed.textContent = 'embed';
      embed.onclick = () => openEmbed(poll);
      actions.append(embed);

      const edit = document.createElement('button');
      edit.type = 'button';
      edit.className = 'btn btn--quiet';
      edit.textContent = 'edit';
      edit.onclick = () => openEdit(poll);
      actions.append(edit);

      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn btn--quiet';
      del.textContent = 'delete';
      del.onclick = () => openDelete(poll);
      actions.append(del);

      li.append(actions);
      list.append(li);
    }
  }

  function setSnippet(sel: string, text: string) {
    const pre = el<HTMLElement>(sel);
    if (!pre) return;
    pre.dataset.resolved = text;
    const code = pre.querySelector('code');
    if (code) code.textContent = text;
  }

  function openEmbed(poll: Poll) {
    setSnippet('[data-embed-badge]', getMarkdownBadgeSnippet(poll.title, poll.id));
    setSnippet('[data-embed-iframe]', getIframeSnippet(poll.id, 380));
    el<HTMLDialogElement>('[data-embed-dialog]')?.showModal();
  }

  function openEdit(poll: Poll) {
    const id = el<HTMLInputElement>('[data-edit-id]');
    const title = el<HTMLInputElement>('[data-edit-title]');
    const desc = el<HTMLTextAreaElement>('[data-edit-desc]');
    const err = el<HTMLElement>('[data-edit-error]');
    if (id) id.value = poll.id;
    if (title) title.value = poll.title;
    if (desc) desc.value = poll.description ?? '';
    if (err) err.hidden = true;
    el<HTMLDialogElement>('[data-edit-dialog]')?.showModal();
  }

  function openDelete(poll: Poll) {
    pendingDeleteId = poll.id;
    const name = el<HTMLElement>('[data-del-title]');
    if (name) name.textContent = `"${poll.title}"`;
    const err = el<HTMLElement>('[data-del-error]');
    if (err) err.hidden = true;
    el<HTMLDialogElement>('[data-del-dialog]')?.showModal();
  }

  async function loadOwned() {
    show('loading');
    const userId = readUserId();

    // Walk pages so a user with many polls still sees all of their own.
    const collected: Poll[] = [];
    let page = 1;
    let pages = 1;

    do {
      const result = await listPolls({ page, perPage: 100, sort: '-created' });
      if (!result.ok) {
        const text = el<HTMLElement>('[data-error-text]');
        if (text) text.textContent = result.error;
        show('error');
        return;
      }
      collected.push(...result.data.items);
      pages = result.data.total_pages || 1;
      page += 1;
    } while (page <= pages && page <= 10);

    owned = userId ? collected.filter((p) => p.owner === userId) : [];

    if (owned.length === 0) {
      show('empty');
      return;
    }
    renderOwned();
    show('results');
  }

  async function loadAccount() {
    const result = await getCurrentUser();
    if (!result.ok) return;

    const line = el<HTMLElement>('[data-owner-line]');
    if (line) {
      line.textContent = `Signed in as ${result.data.user_id}. Your polls, newest first.`;
    }

    if (result.data.deletion_status === 'pending_deletion') {
      const box = el<HTMLElement>('[data-deletion]');
      const when = el<HTMLElement>('[data-deletion-when]');
      if (when && result.data.deletion_scheduled_for) {
        const date = new Date(result.data.deletion_scheduled_for);
        when.textContent = Number.isNaN(date.getTime())
          ? ''
          : ` on ${date.toLocaleDateString()}`;
      }
      if (box) box.hidden = false;
    }
  }

  function wireDialogs() {
    el<HTMLButtonElement>('[data-close-embed]')!.onclick = () =>
      el<HTMLDialogElement>('[data-embed-dialog]')?.close();

    const copyPairs: [string, string][] = [
      ['[data-copy-badge]', '[data-embed-badge]'],
      ['[data-copy-iframe]', '[data-embed-iframe]'],
    ];
    for (const [btnSel, preSel] of copyPairs) {
      const btn = el<HTMLButtonElement>(btnSel);
      if (!btn) continue;
      btn.onclick = async () => {
        const text = el<HTMLElement>(preSel)?.dataset.resolved ?? '';
        if (!text) return;
        const label = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'copied';
        } catch {
          btn.textContent = 'copy failed';
        }
        window.setTimeout(() => {
          btn.textContent = label;
        }, 1600);
      };
    }

    const editDialog = el<HTMLDialogElement>('[data-edit-dialog]');
    el<HTMLButtonElement>('[data-close-edit]')!.onclick = () => editDialog?.close();
    el<HTMLButtonElement>('[data-cancel-edit]')!.onclick = () => editDialog?.close();

    const editForm = el<HTMLFormElement>('[data-edit-form]');
    if (editForm) {
      editForm.onsubmit = async (event) => {
        event.preventDefault();
        const id = el<HTMLInputElement>('[data-edit-id]')?.value ?? '';
        const title = el<HTMLInputElement>('[data-edit-title]')?.value.trim() ?? '';
        const desc = el<HTMLTextAreaElement>('[data-edit-desc]')?.value.trim() ?? '';
        const save = el<HTMLButtonElement>('[data-save-edit]');
        const err = el<HTMLElement>('[data-edit-error]');
        if (!id || title.length < 3) return;

        if (save) {
          save.disabled = true;
          save.textContent = 'saving';
        }

        const result = await updatePoll(id, { title, description: desc || null });

        if (save) {
          save.disabled = false;
          save.textContent = 'Save changes';
        }

        if (!result.ok) {
          if (err) {
            err.textContent = result.error;
            err.hidden = false;
          }
          return;
        }

        editDialog?.close();
        await loadOwned();
      };
    }

    const delDialog = el<HTMLDialogElement>('[data-del-dialog]');
    el<HTMLButtonElement>('[data-close-del]')!.onclick = () => delDialog?.close();
    el<HTMLButtonElement>('[data-cancel-del]')!.onclick = () => delDialog?.close();

    const confirmDel = el<HTMLButtonElement>('[data-confirm-del]');
    if (confirmDel) {
      confirmDel.onclick = async () => {
        if (!pendingDeleteId) return;
        const err = el<HTMLElement>('[data-del-error]');
        confirmDel.disabled = true;
        confirmDel.textContent = 'deleting';

        const result = await deletePoll(pendingDeleteId);

        confirmDel.disabled = false;
        confirmDel.textContent = 'Delete permanently';

        if (!result.ok) {
          if (err) {
            err.textContent = result.error;
            err.hidden = false;
          }
          return;
        }

        pendingDeleteId = null;
        delDialog?.close();
        await loadOwned();
      };
    }
  }

  function wireAccount() {
    const del = el<HTMLButtonElement>('[data-delete-account]');
    const msg = el<HTMLElement>('[data-account-msg]');

    if (del) {
      del.onclick = async () => {
        del.disabled = true;
        const result = await requestAccountDeletion();
        del.disabled = false;
        if (msg) {
          msg.textContent = result.ok
            ? 'Deletion scheduled. You have 7 days to change your mind; reload to see the notice.'
            : result.error;
          msg.hidden = false;
        }
      };
    }

    const cancel = el<HTMLButtonElement>('[data-cancel-deletion]');
    if (cancel) {
      cancel.onclick = async () => {
        cancel.disabled = true;
        const result = await cancelAccountDeletion();
        cancel.disabled = false;
        if (result.ok) {
          const box = el<HTMLElement>('[data-deletion]');
          if (box) box.hidden = true;
        }
      };
    }
  }

  function init() {
    const signedOut = el<HTMLElement>('[data-signedout]');
    const authed = el<HTMLElement>('[data-authed]');

    if (!isSignedIn()) {
      if (signedOut) signedOut.hidden = false;
      if (authed) authed.hidden = true;

      const cta = el<HTMLButtonElement>('[data-signin-cta]');
      const err = el<HTMLElement>('[data-signin-error]');
      if (cta) {
        cta.onclick = async () => {
          cta.disabled = true;
          try {
            await startSignIn('/dashboard');
          } catch (e) {
            if (err) {
              err.textContent = e instanceof Error ? e.message : 'Could not start sign-in.';
              err.hidden = false;
            }
            cta.disabled = false;
          }
        };
      }
      return;
    }

    if (signedOut) signedOut.hidden = true;
    if (authed) authed.hidden = false;

    const retry = el<HTMLButtonElement>('[data-retry]');
    if (retry) retry.onclick = () => loadOwned();

    wireDialogs();
    wireAccount();
    loadAccount();
    loadOwned();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

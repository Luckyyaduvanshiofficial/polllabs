---
/**
 * Landing page. Workbench macrostructure (05): the working product is the
 * argument, so the fold pairs the one line a developer actually copies with a
 * live widget voting against the real API.
 *
 * Sections use four different layout families: split fold, tabular spec sheet,
 * step sequence, and a typographic close. No repeated card triplets.
 */
import RootLayout from '../layouts/RootLayout.astro';
import PollWidget from '../components/embed/PollWidget.svelte';
import { DEMO_FRAMEWORKS_POLL } from '../lib/demo-poll';

const demoId = DEMO_FRAMEWORKS_POLL.id;

// Shown as the copyable snippet. Placeholders resolve client-side to the
// deployed origins so what a visitor copies is what actually works.
const surfaces = [
  {
    surface: 'README badge',
    detail: 'GitHub renders the SVG and links it to the poll page.',
    lang: 'markdown',
    snippet: `[![Poll](API/api/v1/badges/${demoId}.svg)](SITE/polls/${demoId})`,
  },
  {
    surface: 'Interactive embed',
    detail: 'An iframe that accepts votes inline, roughly 5 KB gzipped.',
    lang: 'html',
    snippet: `<iframe src="SITE/embed?id=${demoId}"\n        width="100%" height="380"\n        style="border:0" loading="lazy"></iframe>`,
  },
  {
    surface: 'Plain image',
    detail: 'For Markdown that strips iframes, such as Hugo or Dev.to.',
    lang: 'markdown',
    snippet: `![Poll](API/api/v1/badges/${demoId}.png)`,
  },
];

const guarantees = [
  { key: 'Voting', value: 'Anonymous', note: 'No account needed to vote.' },
  { key: 'Duplicate control', value: 'Device token', note: 'httpOnly cookie, issued server-side.' },
  { key: 'IP handling', value: 'Salted SHA-256', note: 'Raw addresses are never stored.' },
  { key: 'Trackers', value: 'None', note: 'No analytics scripts on embeds.' },
  { key: 'Result masking', value: 'Server-side', note: 'Hidden counts never reach the client.' },
  { key: 'Licence', value: 'Apache 2.0', note: 'Self-host the whole stack.' },
];

const steps = [
  {
    verb: 'Create',
    body: 'Sign in with GitHub, write a question and up to ten options. Pick single-choice, multi-select or quiz mode.',
  },
  {
    verb: 'Embed',
    body: 'Copy one line for a badge or an iframe. The snippet carries your poll id and needs no build step.',
  },
  {
    verb: 'Read',
    body: 'Watch votes land in the dashboard, broken down by option, referrer and day. Export CSV or JSON.',
  },
];
---

<RootLayout>
  <!-- Fold: the snippet a developer copies, beside the widget it produces. -->
  <section class="fold shell">
    <div class="fold__text">
      <h1 class="fold__title">Polls that live in your README.</h1>
      <p class="fold__lede">
        One line of markdown renders a live SVG badge. One iframe accepts votes inline. Both stay in
        sync with the same poll.
      </p>
      <div class="fold__actions">
        <a href="/dashboard/create" class="btn btn--primary">Create a poll</a>
        <a href="/docs" class="btn btn--ghost">Read the docs</a>
      </div>
    </div>

    <div class="fold__proof">
      <p class="field-label fold__proof-label">Live poll, real votes</p>
      <div class="fold__widget">
        <PollWidget client:load pollId={demoId} />
      </div>
    </div>
  </section>

  <!-- Surfaces: three copyable snippets, tabbed rather than stacked as cards. -->
  <section class="surfaces shell rule-top" aria-labelledby="surfaces-title">
    <h2 id="surfaces-title" class="section-title">Three ways to embed one poll</h2>

    <div class="surfaces__grid">
      {
        surfaces.map((item) => (
          <article class="surface">
            <header class="surface__head">
              <h3 class="surface__name">{item.surface}</h3>
              <p class="surface__detail">{item.detail}</p>
            </header>
            <div class="code surface__code">
              <pre data-snippet={item.snippet}><code>{item.snippet}</code></pre>
            </div>
            <button type="button" class="btn btn--quiet surface__copy" data-copy>
              copy {item.lang}
            </button>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Guarantees: F3 tabular spec sheet. Real properties, no invented metrics. -->
  <section class="specs shell rule-top" aria-labelledby="specs-title">
    <h2 id="specs-title" class="section-title">What the platform guarantees</h2>
    <dl class="specs__list">
      {
        guarantees.map((row) => (
          <div class="specs__row">
            <dt class="specs__key">{row.key}</dt>
            <dd class="specs__value">{row.value}</dd>
            <dd class="specs__note">{row.note}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Flow: F4 step sequence, verbs as labels rather than "Step 1". -->
  <section class="flow shell rule-top" aria-labelledby="flow-title">
    <h2 id="flow-title" class="section-title">From question to results</h2>
    <ol class="flow__list">
      {
        steps.map((step) => (
          <li class="flow__step">
            <h3 class="flow__verb">{step.verb}</h3>
            <p class="flow__body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Close: Ft5-adjacent statement, typographic CTA. -->
  <section class="close shell rule-top">
    <p class="close__line">
      Everything above runs on a stack you can host yourself: FastAPI, PocketBase and a static Astro
      front end.
    </p>
    <div class="close__actions">
      <a href="/dashboard/create" class="btn btn--primary">Create a poll</a>
      <a
        href="https://github.com/Luckyyaduvanshiofficial/polls-lab/blob/main/docs/self-hosting.md"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--ghost"
      >
        Self-hosting guide
      </a>
    </div>
  </section>
</RootLayout>

<style>
  .section-title {
    font-size: var(--text-lg);
    color: var(--color-ink);
    margin-bottom: var(--space-lg);
  }

  /* ---- Fold ---- */
  .fold {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-3xl);
    align-items: center;
    padding-block: var(--space-4xl) var(--space-3xl);
  }

  .fold__title {
    font-size: var(--text-display);
    max-width: 22ch;
  }

  .fold__lede {
    margin-top: var(--space-md);
    max-width: 46ch;
    color: var(--color-ink-2);
    font-size: var(--text-base);
  }

  .fold__actions {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  .fold__proof {
    min-width: 0;
  }

  .fold__proof-label {
    margin-bottom: var(--space-xs);
  }

  .fold__widget {
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-paper-inset);
    padding: var(--space-sm);
    min-width: 0;
  }

  /* ---- Surfaces ---- */
  .surfaces,
  .specs,
  .flow,
  .close {
    padding-block: var(--space-3xl);
  }

  .surfaces__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .surface {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-sm);
    min-width: 0;
  }

  .surface__name {
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .surface__detail {
    margin-top: var(--space-2xs);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    line-height: 1.6;
  }

  .surface__code pre {
    white-space: pre-wrap;
    word-break: break-all;
  }

  .surface__copy {
    justify-self: start;
  }

  /* ---- Specs ---- */
  .specs__list {
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .specs__row {
    display: grid;
    grid-template-columns: 12rem 12rem 1fr;
    gap: var(--space-md);
    align-items: baseline;
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .specs__key {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .specs__value {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink);
    font-weight: 500;
  }

  .specs__note {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-ink-3);
  }

  /* ---- Flow ---- */
  .flow__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .flow__step {
    padding-top: var(--space-sm);
    border-top: 2px solid var(--color-accent-dim);
    min-width: 0;
  }

  .flow__verb {
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  .flow__body {
    margin-top: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-ink-3);
    line-height: 1.7;
  }

  /* ---- Close ---- */
  .close__line {
    font-size: var(--text-xl);
    color: var(--color-ink);
    max-width: 48ch;
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
  }

  .close__actions {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
    flex-wrap: wrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 60rem) {
    .fold {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
      padding-block: var(--space-2xl);
    }

    .surfaces__grid,
    .flow__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .specs__row {
      grid-template-columns: 10rem 1fr;
    }

    .specs__note {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .fold__title {
      font-size: var(--text-display-s);
    }

    .specs__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }
  }
</style>

<script>
  import { getApiUrl, getSiteUrl } from '../lib/config';

  /**
   * Snippets ship with API/SITE placeholders so the static build stays origin
   * agnostic; they resolve here to whatever origin is actually serving.
   */
  function resolveSnippets() {
    const api = getApiUrl();
    const site = getSiteUrl();

    document.querySelectorAll<HTMLElement>('pre[data-snippet]').forEach((pre) => {
      const raw = pre.dataset.snippet ?? '';
      const resolved = raw.replaceAll('API', api).replaceAll('SITE', site);
      pre.dataset.resolved = resolved;
      const code = pre.querySelector('code');
      if (code) code.textContent = resolved;
    });
  }

  function wireCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.onclick = async () => {
        const pre = btn.parentElement?.querySelector<HTMLElement>('pre[data-snippet]');
        const text = pre?.dataset.resolved ?? pre?.textContent ?? '';
        if (!text) return;

        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'copied';
        } catch {
          btn.textContent = 'press ctrl+c';
          const range = document.createRange();
          if (pre) {
            range.selectNodeContents(pre);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
        }
        window.setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      };
    });
  }

  function init() {
    resolveSnippets();
    wireCopy();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

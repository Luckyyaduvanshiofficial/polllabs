---
/**
 * Landing page. Workbench macrostructure: the working product is the argument,
 * so the fold pairs the line a developer actually copies with a live widget
 * voting against the real API.
 *
 * Sections use four different layout families: split fold, copy surfaces,
 * guarantee spec sheet, and a verb-labelled flow, closing on a statement.
 */
import RootLayout from '../layouts/RootLayout.astro';
import PollWidget from '../components/embed/PollWidget.svelte';
import { DEMO_FRAMEWORKS_POLL } from '../lib/demo-poll';

const demoId = DEMO_FRAMEWORKS_POLL.id;

// Snippets ship with API/SITE placeholders and resolve client-side, so what a
// visitor copies always points at the origin actually serving them.
const surfaces = [
  {
    surface: 'README badge',
    detail: 'GitHub renders the SVG and links it back to the poll.',
    lang: 'markdown',
    snippet: `[![Poll](API/api/v1/badges/${demoId}.svg)](SITE/polls/${demoId})`,
  },
  {
    surface: 'Interactive embed',
    detail: 'An iframe that accepts votes inline, about 7 KB gzipped.',
    lang: 'html',
    snippet: `<iframe src="SITE/embed?id=${demoId}"\n        width="100%" height="380"\n        style="border:0" loading="lazy"></iframe>`,
  },
  {
    surface: 'Plain image',
    detail: 'For Markdown that strips iframes, such as Hugo or Dev.to.',
    lang: 'markdown',
    snippet: `![Poll](API/api/v1/badges/${demoId}.png)`,
  },
];

const guarantees = [
  { key: 'Voting', value: 'Anonymous', note: 'No account needed to cast a vote.' },
  { key: 'Duplicate control', value: 'Device token', note: 'An httpOnly cookie issued server-side.' },
  { key: 'IP handling', value: 'Salted SHA-256', note: 'Raw addresses are never stored.' },
  { key: 'Trackers', value: 'None', note: 'No analytics scripts ship with an embed.' },
  { key: 'Result masking', value: 'Server-side', note: 'Hidden counts never reach the browser.' },
  { key: 'Licence', value: 'Apache 2.0', note: 'Self-host the entire stack.' },
];

const steps = [
  {
    verb: 'Create',
    body: 'Sign in with GitHub, write a question and up to ten options. Choose single-choice, multi-select or quiz mode.',
  },
  {
    verb: 'Embed',
    body: 'Copy one line for a badge or an iframe. The snippet carries your poll id and needs no build step.',
  },
  {
    verb: 'Measure',
    body: 'Watch votes arrive in the dashboard, split by option, referrer and day. Export CSV or JSON.',
  },
];
---

<RootLayout>
  <!-- Fold: the snippet a developer copies, beside the widget it produces. -->
  <section class="fold">
    <div class="shell fold__grid">
      <div class="fold__text">
        <h1 class="fold__title">Polls that live in your README.</h1>
        <p class="fold__lede">
          One line of markdown renders a live SVG badge. One iframe accepts votes inline. Both stay
          in sync with the same poll.
        </p>
        <div class="fold__actions">
          <a href="/dashboard/create" class="btn btn--primary">Create a poll</a>
          <a href="/docs" class="btn btn--ghost">Read the docs</a>
        </div>
      </div>

      <div class="fold__proof">
        <p class="fold__proof-label">A live poll, taking real votes</p>
        <div class="fold__widget card">
          <PollWidget client:load pollId={demoId} />
        </div>
      </div>
    </div>
  </section>

  <!-- Copy surfaces. -->
  <section class="section" aria-labelledby="surfaces-title">
    <div class="shell">
      <header class="section__head">
        <h2 id="surfaces-title" class="section__title">Three ways to embed one poll</h2>
        <p class="section__lede">
          Every surface reads from the same poll, so results agree wherever you place them.
        </p>
      </header>

      <div class="surfaces">
        {
          surfaces.map((item) => (
            <article class="surface">
              <h3 class="surface__name">{item.surface}</h3>
              <p class="surface__detail">{item.detail}</p>
              <div class="code surface__code">
                <pre data-snippet={item.snippet}><code>{item.snippet}</code></pre>
              </div>
              <button type="button" class="btn btn--quiet surface__copy" data-copy>
                Copy {item.lang}
              </button>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Guarantees: a spec sheet of real properties, no invented metrics. -->
  <section class="section section--tint" aria-labelledby="specs-title">
    <div class="shell">
      <header class="section__head">
        <h2 id="specs-title" class="section__title">What the platform guarantees</h2>
        <p class="section__lede">
          Privacy and abuse handling are decided on the server, not in the widget.
        </p>
      </header>

      <dl class="specs">
        {
          guarantees.map((row) => (
            <div class="specs__row">
              <dt class="specs__key">{row.key}</dt>
              <dd class="specs__value">{row.value}</dd>
              <dd class="specs__note">{row.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Flow: verbs as labels, never "Step 1". -->
  <section class="section" aria-labelledby="flow-title">
    <div class="shell">
      <header class="section__head">
        <h2 id="flow-title" class="section__title">From question to results</h2>
      </header>

      <ol class="flow">
        {
          steps.map((step) => (
            <li class="flow__step">
              <h3 class="flow__verb">{step.verb}</h3>
              <p class="flow__body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Close. -->
  <section class="close">
    <div class="shell close__inner">
      <p class="close__line">
        Everything here runs on a stack you can host yourself: FastAPI, PocketBase and a static Astro
        front end.
      </p>
      <div class="close__actions">
        <a href="/dashboard/create" class="btn btn--primary">Create a poll</a>
        <a
          href="https://github.com/Luckyyaduvanshiofficial/polls-lab/blob/main/docs/self-hosting.md"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--ghost"
        >
          Self-hosting guide
        </a>
      </div>
    </div>
  </section>
</RootLayout>

<style>
  /* ---- Shared section rhythm ---- */
  .section {
    padding-block: var(--space-3xl);
  }

  .section--tint {
    background: var(--color-paper-2);
    border-block: var(--rule-hair) solid var(--color-rule);
  }

  .section__head {
    max-width: 46ch;
    margin-bottom: var(--space-2xl);
  }

  .section__title {
    font-size: var(--text-2xl);
    color: var(--color-ink);
  }

  .section__lede {
    margin-top: var(--space-sm);
    font-size: var(--text-base);
    color: var(--color-ink-3);
    line-height: var(--leading-body);
  }

  /* ---- Fold ---- */
  .fold {
    padding-block: var(--space-4xl) var(--space-3xl);
  }

  .fold__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .fold__title {
    font-size: var(--text-display);
    max-width: 20ch;
  }

  .fold__lede {
    margin-top: var(--space-lg);
    max-width: 46ch;
    font-size: var(--text-lg);
    color: var(--color-ink-3);
    line-height: var(--leading-snug);
  }

  .fold__actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    flex-wrap: wrap;
  }

  .fold__proof {
    min-width: 0;
  }

  .fold__proof-label {
    font-size: var(--text-xs);
    color: var(--color-ink-4);
    margin-bottom: var(--space-sm);
  }

  .fold__widget {
    padding: var(--space-md);
    min-width: 0;
    box-shadow: var(--shadow-lg);
  }

  /* ---- Surfaces ---- */
  .surfaces {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .surface {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-sm);
    min-width: 0;
  }

  .surface__name {
    font-size: var(--text-base);
    color: var(--color-ink);
  }

  .surface__detail {
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    line-height: var(--leading-body);
  }

  .surface__code pre {
    white-space: pre-wrap;
    word-break: break-all;
  }

  .surface__copy {
    justify-self: start;
  }

  /* ---- Specs ---- */
  .specs {
    margin: 0;
    border-top: var(--rule-hair) solid var(--color-rule-strong);
  }

  .specs__row {
    display: grid;
    grid-template-columns: 14rem 12rem 1fr;
    gap: var(--space-lg);
    align-items: baseline;
    padding-block: var(--space-md);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .specs__key {
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }

  .specs__value {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink);
    font-weight: 500;
  }

  .specs__note {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-3);
  }

  /* ---- Flow ---- */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .flow__step {
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-accent);
    min-width: 0;
  }

  .flow__verb {
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .flow__body {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    line-height: var(--leading-body);
  }

  /* ---- Close ---- */
  .close {
    padding-block: var(--space-3xl) var(--space-4xl);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .close__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-xl);
  }

  .close__line {
    font-size: var(--text-xl);
    color: var(--color-ink);
    max-width: 42ch;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-snug);
  }

  .close__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* ---- Responsive ---- */
  @media (max-width: 60rem) {
    .fold {
      padding-block: var(--space-2xl);
    }

    .fold__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xl);
    }

    .surfaces,
    .flow {
      grid-template-columns: minmax(0, 1fr);
    }

    .specs__row {
      grid-template-columns: 11rem 1fr;
      gap: var(--space-sm) var(--space-lg);
    }

    .specs__note {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .fold__title {
      font-size: var(--text-display-s);
    }

    .fold__lede {
      font-size: var(--text-base);
    }

    .specs__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }
  }
</style>

<script>
  import { getApiUrl, getSiteUrl } from '../lib/config';

  function resolveSnippets() {
    const api = getApiUrl();
    const site = getSiteUrl();

    document.querySelectorAll<HTMLElement>('pre[data-snippet]').forEach((pre) => {
      const resolved = (pre.dataset.snippet ?? '').replaceAll('API', api).replaceAll('SITE', site);
      pre.dataset.resolved = resolved;
      const code = pre.querySelector('code');
      if (code) code.textContent = resolved;
    });
  }

  function wireCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.onclick = async () => {
        const pre = btn.parentElement?.querySelector<HTMLElement>('pre[data-snippet]');
        const text = pre?.dataset.resolved ?? pre?.textContent ?? '';
        if (!text) return;

        const original = btn.textContent;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Press Ctrl+C';
          if (pre) {
            const range = document.createRange();
            range.selectNodeContents(pre);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
        }
        window.setTimeout(() => {
          btn.textContent = original;
        }, 1600);
      };
    });
  }

  function init() {
    resolveSnippets();
    wireCopy();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

---
import RootLayout from '../layouts/RootLayout.astro';
import PollWidget from '../components/embed/PollWidget.svelte';
---

<RootLayout title="PollLabs — Embeddable Polls & Leaderboards">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-400 rounded-full">
        Open Source • Apache 2.0
      </span>
      <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white">
        Embeddable Polls & Public Leaderboards
      </h1>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
        Drop interactive polls or static SVG badges directly into your GitHub READMEs, markdown docs, and blogs with zero backend setup.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/dashboard/create"
          class="px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium shadow-sm transition"
        >
          Create Free Poll
        </a>
        <a
          href="/leaderboard"
          class="px-6 py-3 rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 font-medium transition"
        >
          View Leaderboards
        </a>
      </div>
    </div>

    <!-- Live Demo Embed -->
    <div class="flex flex-col items-center justify-center">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Live Svelte Embed Preview</p>
      <PollWidget client:load title="Which framework do you prefer for your web projects?" />
    </div>
  </div>
</RootLayout>

---
import RootLayout from '../layouts/RootLayout.astro';
import PollWidget from '../components/embed/PollWidget.svelte';

const demoPoll = {
  id: 'demo-frameworks',
  title: 'Which web framework is your team prioritizing in 2026?',
  description: 'Vote live below to test instant voting, result percentages, and embed generation.',
  visibility: 'public' as const,
  result_display: 'show_counts' as const,
  owner: 'polllabs-team',
  total_votes: 1420,
  options: [
    { id: '1', text: 'Svelte 5 (Runes & Snippets)', icon_or_image: '🔥', vote_count: 654, percentage: 46.1 },
    { id: '2', text: 'React 19 (Server Actions)', icon_or_image: '⚛️', vote_count: 483, percentage: 34.0 },
    { id: '3', text: 'Astro (Islands Architecture)', icon_or_image: '🚀', vote_count: 283, percentage: 19.9 },
  ],
};

const topPollsSnapshot = [
  {
    id: 'poll-state-manager',
    title: 'Which state management library do you prefer in React?',
    votes: 1248,
    topOption: 'Zustand',
    percentage: 58,
    created: '2 days ago',
  },
  {
    id: 'poll-backend-lang',
    title: 'FastAPI vs Go for new microservices?',
    votes: 932,
    topOption: 'FastAPI',
    percentage: 52,
    created: '4 days ago',
  },
  {
    id: 'poll-astro-deploy',
    title: 'Where do you deploy static Astro websites?',
    votes: 814,
    topOption: 'Cloudflare Pages',
    percentage: 64,
    created: '1 week ago',
  },
];
---

<RootLayout title="PollLabs — Embeddable Polls & Public Leaderboards for Developers">
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 border-b border-[#1e293b]">
    <!-- Ambient Background Glow -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-blue-600/10 blur-[120px] pointer-events-none rounded-full"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1e293b] border border-[#334155] text-xs font-mono text-emerald-400 mb-6 shadow-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Open-source developer platform • Apache 2.0</span>
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
          Embeddable polls that live <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-cyan-400 bg-clip-text text-transparent">
            wherever developers read.
          </span>
        </h1>
        <p class="mt-5 text-base sm:text-lg text-[#94a3b8] max-w-2xl mx-auto leading-relaxed">
          Drop interactive voting widgets into static blogs, or dynamic SVG badges into GitHub READMEs with zero backend setup. Sub-5KB bundle, zero tracking cookies.
        </p>

        <div class="mt-8 flex flex-wrap justify-center items-center gap-3">
          <a
            href="/dashboard/create"
            class="btn-interactive px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-md flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            <span>Create a Free Poll</span>
          </a>
          <a
            href="/leaderboard"
            class="btn-interactive px-6 py-3 rounded-lg bg-[#111827] hover:bg-[#1e293b] border border-[#1e293b] hover:border-[#334155] text-white font-medium text-sm transition"
          >
            Explore Public Leaderboards
          </a>
        </div>
      </div>

      <!-- Two-Column Interactive Sandbox -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start max-w-5xl mx-auto">
        <!-- Left: Live Interactive Poll Widget -->
        <div class="space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="text-xs font-mono font-medium text-[#94a3b8] flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Live Svelte 5 Widget (4.9KB)
            </span>
            <span class="text-[11px] text-[#64748b]">Try clicking an option</span>
          </div>

          <div class="bg-[#111827] border border-[#1e293b] rounded-2xl p-4 shadow-xl">
            <PollWidget
              client:load
              pollId="demo-frameworks"
              initialPoll={demoPoll}
            />
          </div>
        </div>

        <!-- Right: Real-time Embed Code Generator -->
        <div class="space-y-3">
          <div class="flex items-center justify-between px-1">
            <span class="text-xs font-mono font-medium text-[#94a3b8] flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              Instant Embed Generator
            </span>
            <span class="text-[11px] text-[#64748b]">Copy & Paste anywhere</span>
          </div>

          <div class="bg-[#111827] border border-[#1e293b] rounded-2xl p-5 shadow-xl flex flex-col justify-between space-y-4">
            <!-- Tabs -->
            <div class="flex items-center gap-2 border-b border-[#1e293b] pb-3 text-xs font-medium" id="embed-tabs">
              <button
                type="button"
                data-tab="badge"
                class="tab-btn px-3 py-1.5 rounded-md bg-[#1e293b] text-white font-semibold flex items-center gap-1.5 transition"
              >
                <span>GitHub SVG Badge</span>
              </button>
              <button
                type="button"
                data-tab="iframe"
                class="tab-btn px-3 py-1.5 rounded-md text-[#94a3b8] hover:text-white hover:bg-[#1e293b]/50 transition"
              >
                <span>Interactive Iframe</span>
              </button>
            </div>

            <!-- Code Preview Display -->
            <div class="space-y-3">
              <!-- SVG Badge Content -->
              <div id="tab-content-badge" class="tab-pane space-y-3">
                <div class="p-3 rounded-lg bg-[#0b0f19] border border-[#1e293b] flex items-center justify-between">
                  <span class="text-xs text-[#94a3b8]">Live Badge Output:</span>
                  <a href="http://localhost:8000/api/v1/badges/demo-frameworks.svg" target="_blank" class="hover:opacity-90 transition">
                    <img
                      src="http://localhost:8000/api/v1/badges/demo-frameworks.svg"
                      alt="PollLabs Badge"
                      class="h-5"
                      onerror="this.parentElement.innerHTML='<span class=\'text-xs font-mono bg-slate-800 text-emerald-400 px-2 py-0.5 rounded\'>poll: Svelte 5 46% (1420)</span>'"
                    />
                  </a>
                </div>

                <div class="relative">
                  <pre class="bg-[#080c14] border border-[#1e293b] rounded-lg p-3 text-xs font-mono text-emerald-300 overflow-x-auto select-all"><code id="code-badge">[![Which framework do you prefer?](http://localhost:8000/api/v1/badges/demo-frameworks.svg)](http://localhost:4321/embed/demo-frameworks)</code></pre>
                </div>
              </div>

              <!-- Iframe Content -->
              <div id="tab-content-iframe" class="tab-pane hidden space-y-3">
                <p class="text-xs text-[#94a3b8]">
                  Embed into WordPress, Astro, Next.js, Hugo, or raw HTML:
                </p>
                <div class="relative">
                  <pre class="bg-[#080c14] border border-[#1e293b] rounded-lg p-3 text-xs font-mono text-cyan-300 overflow-x-auto select-all"><code id="code-iframe">&lt;iframe src="http://localhost:4321/embed/demo-frameworks" width="100%" height="340" style="border:none;border-radius:16px;max-width:440px;" title="PollLabs"&gt;&lt;/iframe&gt;</code></pre>
                </div>
              </div>
            </div>

            <!-- Copy Button with Feedback -->
            <button
              id="copy-snippet-btn"
              type="button"
              class="btn-interactive w-full py-2.5 px-4 rounded-lg bg-[#1e293b] hover:bg-[#334155] text-white font-medium text-xs flex items-center justify-center gap-2 border border-[#334155] transition"
            >
              <svg id="copy-icon" class="w-3.5 h-3.5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-text">Copy Embed Code</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Benchmarks Strip -->
  <section class="py-10 border-b border-[#1e293b] bg-[#080c14]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="p-4 rounded-xl bg-[#0b0f19] border border-[#1e293b]">
          <div class="text-2xl sm:text-3xl font-mono font-bold text-emerald-400">4.9 KB</div>
          <div class="text-xs text-[#94a3b8] mt-1 font-medium">Embed Bundle Size (gzipped)</div>
        </div>
        <div class="p-4 rounded-xl bg-[#0b0f19] border border-[#1e293b]">
          <div class="text-2xl sm:text-3xl font-mono font-bold text-blue-400">&lt; 150ms</div>
          <div class="text-xs text-[#94a3b8] mt-1 font-medium">Vote Submission Latency</div>
        </div>
        <div class="p-4 rounded-xl bg-[#0b0f19] border border-[#1e293b]">
          <div class="text-2xl sm:text-3xl font-mono font-bold text-cyan-400">0 Tracking</div>
          <div class="text-xs text-[#94a3b8] mt-1 font-medium">No Third-Party Cookies</div>
        </div>
        <div class="p-4 rounded-xl bg-[#0b0f19] border border-[#1e293b]">
          <div class="text-2xl sm:text-3xl font-mono font-bold text-purple-400">100% Free</div>
          <div class="text-xs text-[#94a3b8] mt-1 font-medium">Apache 2.0 Open Source</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Engineering Architecture Pillars -->
  <section class="py-16 border-b border-[#1e293b]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
          Architected for high-traffic developer surfaces
        </h2>
        <p class="text-sm text-[#94a3b8] mt-2">
          Designed specifically to prevent embed lag and eliminate the privacy liabilities of corporate survey widgets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Pillar 1 -->
        <div class="p-6 rounded-2xl bg-[#111827] border border-[#1e293b] space-y-3">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 text-blue-400 flex items-center justify-center font-mono font-bold text-sm">
            01
          </div>
          <h3 class="text-base font-semibold text-white">Ultra-Light Svelte 5 Runtime</h3>
          <p class="text-xs text-[#94a3b8] leading-relaxed">
            Other survey widgets pull in 200KB+ of heavy vendor tracking and UI bloat. PollLabs compiles to a surgical 4.9KB bundle, ensuring your documentation and blog pages maintain perfect Google Core Web Vitals.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="p-6 rounded-2xl bg-[#111827] border border-[#1e293b] space-y-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-mono font-bold text-sm">
            02
          </div>
          <h3 class="text-base font-semibold text-white">Multi-Signal Abuse Mitigation</h3>
          <p class="text-xs text-[#94a3b8] leading-relaxed">
            Combines an anonymous cryptographically signed device token with sliding-window IP hash rate limiting. Avoids false-positive blocks when entire universities or company offices vote from behind the same NAT gateway.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="p-6 rounded-2xl bg-[#111827] border border-[#1e293b] space-y-3">
          <div class="w-10 h-10 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center font-mono font-bold text-sm">
            03
          </div>
          <h3 class="text-base font-semibold text-white">Zero-JS Markdown Badges</h3>
          <p class="text-xs text-[#94a3b8] leading-relaxed">
            GitHub READMEs strip iframe and script tags for security. PollLabs automatically generates dynamic Shields.io-compatible SVG and raster PNG badges showing live vote shares directly in markdown with clickable linkbacks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Live Public Leaderboards Snapshot -->
  <section class="py-16 border-b border-[#1e293b] bg-[#080c14]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <span class="text-xs font-mono text-blue-400 uppercase tracking-wider">Community Feed</span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mt-1">Trending Developer Polls</h2>
        </div>
        <a href="/leaderboard" class="text-xs font-medium text-blue-400 hover:text-blue-300 flex items-center gap-1">
          <span>View all public polls</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {topPollsSnapshot.map((poll) => (
          <div class="p-5 rounded-2xl bg-[#111827] border border-[#1e293b] hover:border-[#334155] transition space-y-4 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs text-[#64748b] font-mono">
                <span>{poll.created}</span>
                <span class="text-emerald-400">{poll.votes.toLocaleString()} votes</span>
              </div>
              <h3 class="text-base font-semibold text-white leading-snug">
                <a href={`/polls/${poll.id}`} class="hover:text-blue-400 transition">
                  {poll.title}
                </a>
              </h3>
            </div>

            <div class="space-y-2 pt-2 border-t border-[#1e293b]">
              <div class="flex justify-between text-xs font-medium">
                <span class="text-[#94a3b8]">Leading: <strong class="text-white">{poll.topOption}</strong></span>
                <span class="text-emerald-400 font-mono">{poll.percentage}%</span>
              </div>
              <div class="w-full bg-[#1e293b] h-2 rounded-full overflow-hidden">
                <div class="bg-blue-500 h-full rounded-full" style={`width: ${poll.percentage}%`}></div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-1">
              <a
                href={`/polls/${poll.id}`}
                class="text-xs text-blue-400 hover:underline font-medium"
              >
                Vote in poll
              </a>
              <a
                href={`/docs?id=${poll.id}`}
                class="text-xs text-[#94a3b8] hover:text-white"
              >
                Get embed code
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom Call to Action -->
  <section class="py-20 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Ready to collect real-time community opinions?
      </h2>
      <p class="text-base text-[#94a3b8] max-w-xl mx-auto">
        Create a poll in seconds. No signup required to vote. Self-host anytime with a single binary.
      </p>
      <div class="flex justify-center gap-4 pt-2">
        <a
          href="/dashboard/create"
          class="btn-interactive px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-md"
        >
          Create Free Poll Now
        </a>
        <a
          href="/docs"
          class="btn-interactive px-6 py-3 rounded-lg bg-[#111827] hover:bg-[#1e293b] border border-[#1e293b] text-white font-medium text-sm"
        >
          Read Integration Docs
        </a>
      </div>
    </div>
  </section>
</RootLayout>

<script>
  function setupEmbedGenerator() {
    const tabs = document.querySelectorAll('#embed-tabs .tab-btn');
    const badgePane = document.getElementById('tab-content-badge');
    const iframePane = document.getElementById('tab-content-iframe');
    const copyBtn = document.getElementById('copy-snippet-btn');
    const copyText = document.getElementById('copy-text');
    let currentTab = 'badge';

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        if (!target) return;
        currentTab = target;

        tabs.forEach((t) => {
          t.classList.remove('bg-[#1e293b]', 'text-white', 'font-semibold');
          t.classList.add('text-[#94a3b8]');
        });
        tab.classList.add('bg-[#1e293b]', 'text-white', 'font-semibold');
        tab.classList.remove('text-[#94a3b8]');

        if (target === 'badge') {
          badgePane?.classList.remove('hidden');
          iframePane?.classList.add('hidden');
        } else {
          iframePane?.classList.remove('hidden');
          badgePane?.classList.add('hidden');
        }
      });
    });

    if (copyBtn && copyText) {
      copyBtn.onclick = () => {
        const codeElement = currentTab === 'badge' ? document.getElementById('code-badge') : document.getElementById('code-iframe');
        const textToCopy = codeElement?.textContent || '';
        navigator.clipboard.writeText(textToCopy).then(() => {
          const originalText = copyText.textContent;
          copyText.textContent = '✓ Copied to clipboard!';
          copyBtn.classList.add('bg-emerald-600', 'border-emerald-500');
          setTimeout(() => {
            copyText.textContent = originalText;
            copyBtn.classList.remove('bg-emerald-600', 'border-emerald-500');
          }, 2000);
        });
      };
    }
  }

  setupEmbedGenerator();
  document.addEventListener('astro:page-load', setupEmbedGenerator);
</script>


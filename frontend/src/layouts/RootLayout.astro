---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Bare pages (the embed iframe) skip the nav and footer. */
  chrome?: boolean;
  /** Keeps a page out of search results, for owner-scoped surfaces. */
  noindex?: boolean;
}

const {
  title = 'Polls Lab · embeddable polls and live README badges',
  description =
    'Create a poll, drop one line of markdown in your README, and get live results as an SVG badge or an interactive embed. Anonymous voting, no trackers, Apache 2.0.',
  chrome = true,
  noindex = false,
} = Astro.props;

const ogImage = new URL('/og-image.svg', Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}
    <link rel="canonical" href={Astro.url.href} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Polls Lab" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fdfdfe" />

    <!-- Written by the container entrypoint at start-up, so the API and
         PocketBase origins are runtime values rather than build-time ones.
         Loaded before any module runs and deliberately not deferred. -->
    <script is:inline src="/runtime-config.js"></script>

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    <!-- Shown only when a deployed build still carries localhost origins, which
         otherwise surfaces to the visitor as a bare "Failed to fetch". -->
    <div class="misconfig" role="alert" data-misconfig hidden>
      <div class="shell misconfig__inner">
        <p class="misconfig__title">This deployment cannot reach its API</p>
        <p class="misconfig__body" data-misconfig-body></p>
      </div>
    </div>

    {chrome && <Navbar />}
    <main id="main" class:list={['main', { 'main--bare': !chrome }]}>
      <slot />
    </main>
    {chrome && <Footer />}

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
      }

      .skip:focus {
        left: var(--space-md);
        top: var(--space-md);
        padding: var(--space-xs) var(--space-md);
        background: var(--color-accent);
        color: var(--color-accent-ink);
        border-radius: var(--radius-md);
        font-size: var(--text-sm);
      }

      .main {
        flex: 1;
        width: 100%;
      }

      .main--bare {
        display: flex;
      }

      .misconfig {
        background: var(--color-danger-soft);
        border-bottom: var(--rule-hair) solid var(--color-danger);
      }

      .misconfig__inner {
        padding-block: var(--space-sm);
      }

      .misconfig__title {
        font-size: var(--text-sm);
        font-weight: 600;
        color: var(--color-danger);
      }

      .misconfig__body {
        margin-top: var(--space-2xs);
        font-size: var(--text-xs);
        color: var(--color-ink-2);
        line-height: var(--leading-body);
      }
    </style>
    <script>
      import { findMisconfiguredOrigins, warnIfMisconfigured } from '../lib/config';

      function checkOrigins() {
        warnIfMisconfigured();

        const broken = findMisconfiguredOrigins();
        const banner = document.querySelector('[data-misconfig]');
        const body = document.querySelector('[data-misconfig-body]');
        if (!banner || !body) return;

        if (broken.length === 0) {
          banner.hidden = true;
          return;
        }

        body.textContent =
          `${broken.join(' and ')} still ${broken.length > 1 ? 'point' : 'points'} at localhost ` +
          `in this build, so sign-in and every data request fail. These values are inlined at ` +
          `build time: set them as Docker build args and rebuild the frontend image.`;
        banner.hidden = false;
      }

      checkOrigins();
      document.addEventListener('astro:page-load', checkOrigins);
    </script>
  </body>
</html>

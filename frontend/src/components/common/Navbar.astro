---
/**
 * N1b canonical three-section nav: wordmark left, link cluster centre, account
 * actions right. Frosts against the paper on scroll rather than sitting on a
 * hard rule, which is what keeps a light header feeling light.
 */
const currentPath = Astro.url.pathname;

const links = [
  { href: '/polls', label: 'Polls' },
  { href: '/leaderboard', label: 'Leaderboard' },
  { href: '/docs', label: 'Docs' },
];

const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<header class="nav" data-nav>
  <div class="shell nav__inner">
    <a href="/" class="brand" aria-label="Polls Lab home">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="9" stroke="currentColor" stroke-width="1.6" opacity="0.28" />
          <path
            d="M10 1a9 9 0 0 1 0 18Z"
            fill="currentColor"
          />
        </svg>
      </span>
      <span class="brand__name">Polls Lab</span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav__link', { 'nav__link--on': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/dashboard"
        class:list={['nav__link', { 'nav__link--on': isActive('/dashboard') }]}
        data-auth-only
        hidden
      >
        Dashboard
      </a>
    </nav>

    <div class="nav__actions">
      <button type="button" class="btn btn--quiet" data-signin hidden>Sign in</button>
      <button type="button" class="btn btn--quiet" data-signout hidden>Sign out</button>
      <a href="/dashboard/create" class="btn btn--primary nav__cta">Create poll</a>

      <button
        type="button"
        class="nav__burger"
        data-burger
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Open menu"
      >
        <span class="nav__burger-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="nav-drawer" data-drawer hidden>
    <div class="shell nav__drawer-inner">
      {
        links.map((link) => (
          <a href={link.href} class="nav__drawer-link">
            {link.label}
          </a>
        ))
      }
      <a href="/dashboard" class="nav__drawer-link" data-auth-only hidden>Dashboard</a>
      <a href="/dashboard/create" class="btn btn--primary nav__drawer-cta">Create poll</a>
    </div>
  </div>

  <p class="nav__error" role="alert" data-auth-error hidden></p>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--color-paper) 82%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    transition: box-shadow var(--dur-mid) var(--ease-out);
  }

  /* The rule only appears once the page has moved, so the header reads as part
   * of the paper at rest. */
  .nav[data-scrolled='true'] {
    box-shadow: 0 1px 0 var(--color-rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--color-accent);
  }

  .brand__mark svg {
    width: 100%;
    height: 100%;
  }

  .brand__name {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    flex: 1;
    min-width: 0;
  }

  .nav__link {
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-3);
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--color-ink);
    background: var(--color-paper-3);
  }

  .nav__link--on {
    color: var(--color-accent-strong);
    background: var(--color-accent-soft);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .nav__error {
    padding: var(--space-xs) var(--page-gutter);
    background: var(--color-danger-soft);
    color: var(--color-danger);
    font-size: var(--text-xs);
    border-top: var(--rule-hair) solid var(--color-danger);
  }

  .nav__burger {
    display: none;
    appearance: none;
    background: transparent;
    border: var(--rule-hair) solid var(--color-rule-strong);
    border-radius: var(--radius-pill);
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }

  .nav__burger-bars,
  .nav__burger-bars::before,
  .nav__burger-bars::after {
    display: block;
    width: 15px;
    height: 1.5px;
    background: var(--color-ink-2);
    border-radius: var(--radius-pill);
  }

  .nav__burger-bars::before,
  .nav__burger-bars::after {
    content: '';
    position: relative;
  }

  .nav__burger-bars::before {
    top: -4.5px;
  }

  .nav__burger-bars::after {
    top: 3px;
  }

  .nav__drawer {
    display: none;
    border-top: var(--rule-hair) solid var(--color-rule);
    background: var(--color-paper);
  }

  @media (max-width: 60rem) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: inline-flex;
    }

    .nav__drawer {
      display: block;
    }

    .nav__drawer[hidden] {
      display: none;
    }

    .nav__drawer-inner {
      display: grid;
      gap: var(--space-2xs);
      padding-block: var(--space-md) var(--space-lg);
    }

    .nav__drawer-link {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding: var(--space-xs) var(--space-sm);
      border-radius: var(--radius-md);
      font-size: var(--text-base);
      font-weight: 500;
      color: var(--color-ink-2);
    }

    .nav__drawer-link:hover {
      background: var(--color-paper-3);
      color: var(--color-ink);
    }

    .nav__drawer-cta {
      margin-top: var(--space-sm);
      justify-self: start;
    }
  }

  @media (max-width: 40rem) {
    .nav__inner {
      gap: var(--space-md);
    }

    .nav__cta {
      display: none;
    }
  }
</style>

<script>
  import { isSignedIn, signOut, startSignIn } from '../../lib/auth';

  function syncAuthChrome() {
    const signedIn = isSignedIn();

    document.querySelectorAll<HTMLElement>('[data-auth-only]').forEach((el) => {
      el.hidden = !signedIn;
    });
    document.querySelectorAll<HTMLElement>('[data-signin]').forEach((el) => {
      el.hidden = signedIn;
    });
    document.querySelectorAll<HTMLElement>('[data-signout]').forEach((el) => {
      el.hidden = !signedIn;
    });
  }

  function showAuthError(message: string) {
    const box = document.querySelector<HTMLElement>('[data-auth-error]');
    if (!box) return;
    box.textContent = message;
    box.hidden = false;
  }

  let onScroll: (() => void) | null = null;

  function wire() {
    syncAuthChrome();

    document.querySelectorAll<HTMLButtonElement>('[data-signin]').forEach((btn) => {
      btn.onclick = async () => {
        btn.disabled = true;
        btn.textContent = 'Opening GitHub';
        try {
          await startSignIn(window.location.pathname);
        } catch (err) {
          showAuthError(err instanceof Error ? err.message : 'Could not start sign-in.');
          btn.disabled = false;
          btn.textContent = 'Sign in';
        }
      };
    });

    document.querySelectorAll<HTMLButtonElement>('[data-signout]').forEach((btn) => {
      btn.onclick = () => signOut('/');
    });

    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const drawer = document.querySelector<HTMLElement>('[data-drawer]');
    if (burger && drawer) {
      burger.onclick = () => {
        const open = !drawer.hidden;
        drawer.hidden = open;
        burger.setAttribute('aria-expanded', String(!open));
        burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      };
    }

    // Passive listener, and it only toggles one attribute, so it never
    // measures layout on scroll.
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (nav) {
      if (onScroll) window.removeEventListener('scroll', onScroll);
      onScroll = () => {
        nav.dataset.scrolled = String(window.scrollY > 4);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  wire();
  document.addEventListener('astro:page-load', wire);
</script>

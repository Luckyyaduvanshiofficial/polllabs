---
/**
 * N8 Terminal command nav. The links read as CLI flags, which fits a product
 * whose main surface is a README badge. The blinking caret is permitted here
 * only: it signals "you would type next" rather than decorating the page.
 */
const currentPath = Astro.url.pathname;

const links = [
  { href: '/polls', flag: '--polls' },
  { href: '/leaderboard', flag: '--board' },
  { href: '/docs', flag: '--docs' },
];

const isActive = (path: string) =>
  path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<header class="nav rule-bottom">
  <div class="shell nav__inner">
    <a href="/" class="nav__brand" aria-label="Polls Lab home">
      <span class="nav__prompt" aria-hidden="true">&gt;</span>
      <span class="nav__word">polls-lab</span>
    </a>

    <nav class="nav__flags" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav__flag', { 'nav__flag--on': isActive(link.href) }]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.flag}
          </a>
        ))
      }
      <a
        href="/dashboard"
        class:list={['nav__flag', 'nav__flag--auth', { 'nav__flag--on': isActive('/dashboard') }]}
        data-auth-only
        hidden
      >
        --dashboard
      </a>
      <span class="nav__caret" aria-hidden="true">&#9646;</span>
    </nav>

    <div class="nav__actions">
      <button type="button" class="btn btn--quiet" data-signin hidden>sign in</button>
      <button type="button" class="btn btn--quiet" data-signout hidden>sign out</button>
      <a href="/dashboard/create" class="btn btn--primary nav__cta">New poll</a>
      <button
        type="button"
        class="nav__burger btn btn--quiet"
        data-burger
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Toggle menu"
      >
        <span aria-hidden="true">menu</span>
      </button>
    </div>
  </div>

  <div class="nav__drawer rule-top" id="nav-drawer" data-drawer hidden>
    <div class="shell nav__drawer-inner">
      {
        links.map((link) => (
          <a href={link.href} class="nav__drawer-link">
            {link.flag.replace('--', '')}
          </a>
        ))
      }
      <a href="/dashboard" class="nav__drawer-link" data-auth-only hidden>dashboard</a>
      <a href="/dashboard/create" class="nav__drawer-link nav__drawer-link--cta">new poll</a>
    </div>
  </div>

  <p class="nav__error" role="alert" data-auth-error hidden></p>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    min-height: 3.25rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4ch;
    font-size: var(--text-sm);
    font-weight: 600;
    flex-shrink: 0;
  }

  .nav__prompt {
    color: var(--color-accent);
  }

  .nav__word {
    color: var(--color-ink);
  }

  .nav__brand:hover .nav__word {
    color: var(--color-accent);
  }

  .nav__flags {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    font-size: var(--text-sm);
    flex: 1;
    min-width: 0;
  }

  .nav__flag {
    color: var(--color-ink-3);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }

  .nav__flag:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-ink-4);
  }

  .nav__flag--on {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .nav__caret {
    display: inline-block;
    width: 1ch;
    color: var(--color-accent);
    animation: nav-blink 1.05s steps(2) infinite;
  }

  @keyframes nav-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__caret {
      animation: none;
    }
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
  }

  .nav__error {
    margin: 0;
    padding: var(--space-xs) var(--page-gutter);
    background: var(--color-danger-wash);
    color: var(--color-danger);
    font-size: var(--text-xs);
    border-top: var(--rule-hair) solid var(--color-danger);
  }

  .nav__burger,
  .nav__drawer {
    display: none;
  }

  /* Below the layout breakpoint the flag row collapses behind `menu`, keeping
   * the terminal voice rather than switching to a hamburger glyph. */
  @media (max-width: 60rem) {
    .nav__flags {
      display: none;
    }

    .nav__burger {
      display: inline-flex;
    }

    .nav__drawer {
      display: block;
    }

    .nav__drawer[hidden] {
      display: none;
    }

    .nav__drawer-inner {
      display: flex;
      flex-direction: column;
      padding-block: var(--space-xs);
    }

    .nav__drawer-link {
      padding: var(--space-sm) 0;
      min-height: 2.75rem;
      display: flex;
      align-items: center;
      font-size: var(--text-sm);
      color: var(--color-ink-2);
      border-bottom: var(--rule-hair) solid var(--color-rule);
    }

    .nav__drawer-link:last-child {
      border-bottom: none;
    }

    .nav__drawer-link--cta {
      color: var(--color-accent);
    }
  }

  @media (max-width: 40rem) {
    .nav__cta {
      padding-inline: var(--space-sm);
    }
  }
</style>

<script>
  import { isSignedIn, signOut, startSignIn } from '../../lib/auth';

  function syncAuthChrome() {
    const signedIn = isSignedIn();

    document.querySelectorAll<HTMLElement>('[data-auth-only]').forEach((el) => {
      el.hidden = !signedIn;
    });
    document.querySelectorAll<HTMLElement>('[data-signin]').forEach((el) => {
      el.hidden = signedIn;
    });
    document.querySelectorAll<HTMLElement>('[data-signout]').forEach((el) => {
      el.hidden = !signedIn;
    });
  }

  function showAuthError(message: string) {
    const box = document.querySelector<HTMLElement>('[data-auth-error]');
    if (!box) return;
    box.textContent = message;
    box.hidden = false;
  }

  function wire() {
    syncAuthChrome();

    document.querySelectorAll<HTMLButtonElement>('[data-signin]').forEach((btn) => {
      btn.onclick = async () => {
        btn.disabled = true;
        btn.textContent = 'opening GitHub';
        try {
          await startSignIn(window.location.pathname);
        } catch (err) {
          showAuthError(err instanceof Error ? err.message : 'Could not start sign-in.');
          btn.disabled = false;
          btn.textContent = 'sign in';
        }
      };
    });

    document.querySelectorAll<HTMLButtonElement>('[data-signout]').forEach((btn) => {
      btn.onclick = () => signOut('/');
    });

    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const drawer = document.querySelector<HTMLElement>('[data-drawer]');
    if (burger && drawer) {
      burger.onclick = () => {
        const open = !drawer.hidden;
        drawer.hidden = open;
        burger.setAttribute('aria-expanded', String(!open));
      };
    }
  }

  wire();
  document.addEventListener('astro:page-load', wire);
</script>

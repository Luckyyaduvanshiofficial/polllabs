---
/**
 * Ft4 Dense typographic colophon. A single mono block of credits and status
 * rather than four columns of links, which suits a tool whose surface area is
 * small and whose audience reads mono comfortably.
 *
 * The API links resolve at runtime through getApiUrl() rather than being
 * hardcoded to localhost, so a deployed build points at the deployed API.
 */
import { getApiUrl } from '../../lib/config';

const year = new Date().getFullYear();
const apiUrl = getApiUrl();
const repo = 'https://github.com/Luckyyaduvanshiofficial/polls-lab';
---

<footer class="foot rule-top">
  <div class="shell foot__inner">
    <p class="foot__colophon">
      <span class="foot__mark">polls-lab</span> builds embeddable polls, live SVG badges and public
      leaderboards. Astro, Svelte 5 and Tailwind on the front; FastAPI and PocketBase behind.
      Apache 2.0 licensed. Anonymous voting, hashed IPs, no third-party trackers.
      &copy; {year}.
    </p>

    <nav class="foot__links" aria-label="Resources">
      <a href="/docs">docs</a>
      <a href="/leaderboard">leaderboard</a>
      <a href="/theme-samples">themes</a>
      <a href={repo} target="_blank" rel="noopener noreferrer">source</a>
      <a href={`${repo}/blob/main/docs/self-hosting.md`} target="_blank" rel="noopener noreferrer">
        self-hosting
      </a>
      <a href={`${apiUrl}/docs`} target="_blank" rel="noopener noreferrer">openapi</a>
      <a
        href={`${apiUrl}/api/v1/health`}
        target="_blank"
        rel="noopener noreferrer"
        class="foot__status"
        data-health-link
      >
        <span class="foot__dot" data-health-dot aria-hidden="true"></span>
        <span data-health-text>api status</span>
      </a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    margin-top: auto;
    padding-block: var(--space-xl);
  }

  .foot__inner {
    display: grid;
    gap: var(--space-md);
  }

  .foot__colophon {
    font-size: var(--text-xs);
    line-height: 1.75;
    color: var(--color-ink-3);
    max-width: 78ch;
  }

  .foot__mark {
    color: var(--color-ink);
    font-weight: 600;
  }

  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-xs);
  }

  .foot__links a {
    color: var(--color-ink-3);
    text-decoration: underline;
    text-decoration-color: var(--color-rule-strong);
    text-underline-offset: 3px;
    min-height: 1.75rem;
    display: inline-flex;
    align-items: center;
  }

  .foot__links a:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .foot__status {
    gap: 0.5ch;
  }

  /* This dot carries real state (a live health probe), which is the only case
   * where a status dot earns its place. */
  .foot__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-ink-4);
    flex-shrink: 0;
  }

  .foot__dot[data-state='up'] {
    background: var(--color-accent);
  }

  .foot__dot[data-state='down'] {
    background: var(--color-danger);
  }

  @media (max-width: 40rem) {
    .foot__links {
      gap: var(--space-sm) var(--space-md);
    }
  }
</style>

<script>
  import { getHealth } from '../../lib/api';

  async function probeHealth() {
    const dot = document.querySelector<HTMLElement>('[data-health-dot]');
    const text = document.querySelector<HTMLElement>('[data-health-text]');
    if (!dot || !text) return;

    const result = await getHealth();
    if (result.ok) {
      dot.dataset.state = 'up';
      text.textContent = 'api reachable';
    } else {
      dot.dataset.state = 'down';
      text.textContent = 'api unreachable';
    }
  }

  probeHealth();
  document.addEventListener('astro:page-load', probeHealth);
</script>

---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-white/[0.04] py-16 text-[#94a3b8] text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      <!-- Brand -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center font-mono font-bold text-[10px] text-white">
            PL
          </div>
          <span class="font-bold text-base text-white tracking-tight">Polls Lab</span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/[0.06] text-emerald-400 font-mono">Apache 2.0</span>
        </div>
        <p class="text-xs text-[#64748b] max-w-sm leading-relaxed">
          Open-source embeddable polls, Shields-compatible README badges, and transparent public leaderboards for developer communities.
        </p>
        <div class="flex items-center gap-3 text-xs font-mono text-[#64748b]">
          <span>FastAPI</span>
          <span class="text-[#334155]">/</span>
          <span>PocketBase</span>
          <span class="text-[#334155]">/</span>
          <span>Svelte 5</span>
          <span class="text-[#334155]">/</span>
          <span>Astro</span>
        </div>
      </div>

      <!-- Resources -->
      <div class="space-y-3">
        <h4 class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b]">Resources</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/docs" class="hover:text-white transition">Documentation</a></li>
          <li><a href="/leaderboard" class="hover:text-white transition">Leaderboards</a></li>
          <li><a href="/dashboard/create" class="hover:text-white transition">Create a Poll</a></li>
          <li><a href="https://github.com/Luckyyaduvanshiofficial/polls-lab/blob/main/docs/self-hosting.md" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">Self-Hosting</a></li>
        </ul>
      </div>

      <!-- System -->
      <div class="space-y-3">
        <h4 class="text-[11px] font-semibold uppercase tracking-wider text-[#64748b]">System</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="https://github.com/Luckyyaduvanshiofficial/polls-lab" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">GitHub</a></li>
          <li><a href="http://localhost:8000/docs" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">OpenAPI Spec</a></li>
          <li><a href="http://localhost:8000/api/v1/health" target="_blank" rel="noopener noreferrer" class="hover:text-white transition flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> API Status</a></li>
          <li><a href="https://github.com/Luckyyaduvanshiofficial/polls-lab/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:text-white transition">License</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="pt-8 border-t border-white/[0.04] flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-[#475569]">
      <p>&copy; {currentYear} Polls Lab. Free and open-source.</p>
      <p className="font-mono">Zero tracking / Sub-5KB embed / Privacy-first</p>
    </div>
  </div>
</footer>

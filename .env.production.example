# ─── Polls Lab — Production Environment Template ──────────────────────────────
# Copy this to .env on your VPS/Dokploy and fill in real values.
# NEVER commit the real .env to git.

# ── PocketBase ────────────────────────────────────────────────────────────────
POCKETBASE_URL=https://pollslabdb.dokku.space
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change_this_to_strong_password

# ── GitHub OAuth (create at github.com/settings/developers) ──────────────────
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# ── Security ──────────────────────────────────────────────────────────────────
# Both are REQUIRED in production: the app refuses to start without them.
# Generate each with: openssl rand -hex 32
IP_HASH_SALT=generate_a_random_32_byte_hex_salt_here
ADMIN_API_KEY=generate_a_separate_random_32_byte_hex_key_here

# ── CORS (your frontend domain, comma-separated for several) ─────────────────
BACKEND_CORS_ORIGINS=https://polls-lab.your-domain.com

# ── Frontend Public Env ──────────────────────────────────────────────────────
# Set these as ordinary environment variables on the FRONTEND service. The
# container entrypoint writes them into runtime-config.js at start-up, so a
# restart is enough and no rebuild is required.
# PUBLIC_SITE_URL is additionally read at build time for canonical and og: URLs,
# so pass it as a build arg too if you care about social previews.
PUBLIC_API_URL=https://api.polls-lab.your-domain.com
PUBLIC_SITE_URL=https://polls-lab.your-domain.com
PUBLIC_PB_URL=https://db.polls-lab.your-domain.com
